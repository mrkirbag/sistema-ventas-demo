# Copiá este archivo a .env y completá los valores.
# Nunca subas .env al repositorio.

JWT_SECRET=

# Primer admin (defaults si las omitís: admin / admin123)
SEED_ADMIN_USER=admin
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NOMBRE=Administrador
SEED_TASA=4000
SEED_TASA_BS=36.50

# Opcional — cliente de mostrador
SEED_CLIENTE_NOMBRE=Consumidor final
SEED_CLIENTE_CEDULA=V-00000000
SEED_CLIENTE_TELEFONO=0000-0000000

# Membresía (Turso)
DATABASE_URL=libsql://
DATABASE_AUTH_TOKEN=

# Licencia local (en vez de Turso; sin token)
# DATABASE_URL=file:savi.db
