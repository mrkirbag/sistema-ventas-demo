---
const phoneNumber = "584247217176";
const quickWhatsappUrl = `https://wa.me/${phoneNumber}?text=${encodeURIComponent("Hola! 👋 Deseo más información sobre el sistema SAVI.")}`;
---

<section
    class="relative snap-start scroll-mt-10 px-4 sm:px-6 lg:px-8 py-20 sm:py-24 lg:py-28 min-h-screen flex flex-col justify-center items-center overflow-hidden"
    id="contacto"
>
    <!-- Background Tech Grid Pattern with Vignette Mask -->
    <div
        class="pointer-events-none absolute inset-0 bg-[linear-gradient(to_right,#ffffff05_1px,transparent_1px),linear-gradient(to_bottom,#ffffff05_1px,transparent_1px)] bg-[size:3.5rem_3.5rem] [mask-image:radial-gradient(ellipse_65%_55%_at_50%_50%,#000_60%,transparent_100%)] opacity-70"
    >
    </div>

    <!-- Multi-layered Ambient Glows -->
    <div class="pointer-events-none absolute inset-0 overflow-hidden">
        <div
            class="absolute top-1/3 -left-32 w-[500px] h-[500px] bg-tertiary/15 blur-[150px] rounded-full"
        >
        </div>
        <div
            class="absolute bottom-1/4 -right-32 w-[550px] h-[550px] bg-accent/15 blur-[160px] rounded-full"
        >
        </div>
    </div>

    <div class="mx-auto max-w-7xl w-full relative z-10">
        <div class="grid gap-12 lg:gap-16 lg:grid-cols-12 items-center">
            <!-- Left Info Column (5 cols) -->
            <div class="lg:col-span-5 flex flex-col justify-center gap-6">
                <!-- Eyebrow Badge -->
                <div
                    class="inline-flex items-center gap-2 self-start px-4 py-1.5 rounded-full border border-emerald-500/40 bg-emerald-500/10 backdrop-blur-md shadow-[0_0_20px_rgba(16,185,129,0.2)]"
                >
                    <span class="relative flex h-2 w-2">
                        <span
                            class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"
                        ></span>
                        <span
                            class="relative inline-flex rounded-full h-2 w-2 bg-emerald-400 shadow-[0_0_8px_rgba(52,211,153,0.9)]"
                        ></span>
                    </span>
                    <span
                        class="text-xs sm:text-sm font-bold uppercase tracking-wider text-emerald-300"
                    >
                        Atención Inmediata • WhatsApp
                    </span>
                </div>

                <!-- Main Title -->
                <h2
                    class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight"
                >
                    ¿Listo para transformar <br class="hidden sm:inline" />
                    <span
                        class="text-transparent bg-clip-text bg-linear-to-r from-accent via-purple-300 to-tertiary drop-shadow-[0_0_25px_rgba(168,85,247,0.4)]"
                    >
                        tu negocio con SAVI?
                    </span>
                </h2>

                <p class="text-base sm:text-lg text-text-muted leading-relaxed">
                    Escríbenos directamente para agendar una demostración en
                    vivo, conocer más sobre los planes o recibir asesoría a la
                    medida de tu empresa.
                </p>

                <!-- Direct Contact Cards -->
                <div class="flex flex-col gap-3.5 mt-2">
                    <!-- WhatsApp Card -->
                    <a
                        href={quickWhatsappUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="group flex items-center justify-between p-4 rounded-2xl border border-white/10 bg-white/[0.04] hover:bg-emerald-500/10 hover:border-emerald-500/40 transition-all duration-300 shadow-lg hover:shadow-emerald-500/10 hover:-translate-y-0.5"
                    >
                        <div class="flex items-center gap-4">
                            <div
                                class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-emerald-500/15 border border-emerald-500/30 text-emerald-400 group-hover:scale-110 group-hover:bg-emerald-500/25 transition-all duration-300 shadow-[0_0_15px_rgba(16,185,129,0.3)]"
                            >
                                <svg
                                    class="w-6 h-6 fill-current"
                                    viewBox="0 0 24 24"
                                >
                                    <path
                                        d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.275.072.376-.044c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.086s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.099.824zm-3.394-10.416c-4.409 0-7.996 3.587-7.996 7.996 0 1.408.365 2.784 1.059 4.001l-1.096 4.003 4.129-1.083c1.178.643 2.506.983 3.904.984 4.409 0 7.996-3.587 7.996-7.996 0-4.409-3.587-7.996-7.996-7.996zm0 14.509c-1.246 0-2.463-.335-3.526-.968l-.253-.15-2.61.685.696-2.544-.165-.263c-.699-1.112-1.069-2.399-1.069-3.722 0-3.649 2.969-6.618 6.619-6.618 3.649 0 6.618 2.969 6.618 6.618 0 3.649-2.969 6.618-6.618 6.618z"
                                    ></path>
                                </svg>
                            </div>
                            <div class="flex flex-col">
                                <span
                                    class="text-xs font-semibold text-text-muted"
                                    >Chat WhatsApp Directo</span
                                >
                                <span
                                    class="text-base font-bold text-white group-hover:text-emerald-300 transition-colors"
                                    >+58 424-7217176</span
                                >
                            </div>
                        </div>
                        <span
                            class="text-xs font-semibold text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 px-2.5 py-1 rounded-full flex items-center gap-1.5"
                        >
                            <span
                                class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"
                            ></span>
                            Online
                        </span>
                    </a>

                    <!-- Email Card -->
                    <a
                        href="mailto:fadikirbag5@gmail.com"
                        class="group flex items-center justify-between p-4 rounded-2xl border border-white/10 bg-white/[0.04] hover:bg-accent/10 hover:border-accent/40 transition-all duration-300 shadow-lg hover:shadow-accent/10 hover:-translate-y-0.5"
                    >
                        <div class="flex items-center gap-4">
                            <div
                                class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-accent/15 border border-accent/30 text-accent group-hover:scale-110 group-hover:bg-accent/25 transition-all duration-300 shadow-[0_0_15px_rgba(168,85,247,0.3)]"
                            >
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    width="22"
                                    height="22"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                >
                                    <rect
                                        width="20"
                                        height="16"
                                        x="2"
                                        y="4"
                                        rx="2"></rect>
                                    <path
                                        d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"
                                    ></path>
                                </svg>
                            </div>
                            <div class="flex flex-col">
                                <span
                                    class="text-xs font-semibold text-text-muted"
                                    >Correo Electrónico</span
                                >
                                <span
                                    class="text-base font-bold text-white group-hover:text-purple-300 transition-colors"
                                    >fadikirbag5@gmail.com</span
                                >
                            </div>
                        </div>
                        <span
                            class="text-xs font-semibold text-purple-300 bg-accent/10 border border-accent/20 px-2.5 py-1 rounded-full"
                        >
                            Escríbenos
                        </span>
                    </a>
                </div>
            </div>

            <!-- Right Form Column (7 cols) -->
            <div class="lg:col-span-7">
                <div
                    class="relative group rounded-3xl p-[1.5px] bg-linear-to-b from-accent/50 via-purple-500/20 to-white/10 shadow-[0_0_50px_-10px_rgba(168,85,247,0.3)] hover:shadow-[0_0_70px_rgba(168,85,247,0.45)] transition-all duration-500"
                >
                    <div
                        class="relative rounded-[23px] bg-linear-to-b from-[#1F0A52]/95 via-[#16063D]/95 to-[#0F0529]/98 backdrop-blur-2xl p-6 sm:p-9 overflow-hidden"
                    >
                        <!-- Internal ambient spotlights -->
                        <div
                            class="pointer-events-none absolute -top-20 -right-20 h-56 w-56 bg-accent/20 blur-[90px] rounded-full group-hover:bg-accent/30 transition-all duration-700"
                        >
                        </div>
                        <div
                            class="pointer-events-none absolute -bottom-20 -left-20 h-56 w-56 bg-tertiary/20 blur-[90px] rounded-full group-hover:bg-tertiary/30 transition-all duration-700"
                        >
                        </div>

                        <!-- Form Title & Header -->
                        <div class="relative z-10 mb-6">
                            <h3
                                class="text-xl sm:text-2xl font-black text-white tracking-tight flex items-center gap-2"
                            >
                                <span>Envíanos un mensaje</span>
                                <span class="text-accent text-lg">✨</span>
                            </h3>
                            <p class="text-xs sm:text-sm text-text-muted mt-1">
                                Completa los campos y serás redirigido
                                directamente a WhatsApp con tus datos listos
                                para chatear.
                            </p>
                        </div>

                        <!-- Form -->
                        <form
                            class="grid gap-4 sm:gap-5 relative z-10"
                            id="whatsapp-contact-form"
                        >
                            <div class="grid gap-4 sm:grid-cols-2">
                                <!-- Nombre -->
                                <div class="space-y-1.5">
                                    <label
                                        for="contact-name"
                                        class="block text-xs font-bold uppercase tracking-wider text-purple-200/90 ml-1"
                                    >
                                        Nombre Completo <span
                                            class="text-accent">*</span
                                        >
                                    </label>
                                    <div class="relative">
                                        <div
                                            class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5 text-white/40"
                                        >
                                            <svg
                                                xmlns="http://www.w3.org/2000/svg"
                                                class="h-4 w-4"
                                                viewBox="0 0 24 24"
                                                fill="none"
                                                stroke="currentColor"
                                                stroke-width="2"
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                            >
                                                <path
                                                    d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"
                                                ></path>
                                                <circle cx="12" cy="7" r="4"
                                                ></circle>
                                            </svg>
                                        </div>
                                        <input
                                            id="contact-name"
                                            name="name"
                                            type="text"
                                            placeholder="Tu nombre y apellido"
                                            required
                                            class="w-full rounded-xl border border-white/15 bg-white/[0.04] pl-10 pr-4 py-3 text-sm text-white focus:border-accent focus:bg-white/[0.08] focus:ring-2 focus:ring-accent/40 outline-none transition-all duration-300 placeholder:text-white/30 hover:border-white/30"
                                        />
                                    </div>
                                </div>

                                <!-- Teléfono / WhatsApp -->
                                <div class="space-y-1.5">
                                    <label
                                        for="contact-phone"
                                        class="block text-xs font-bold uppercase tracking-wider text-purple-200/90 ml-1"
                                    >
                                        Teléfono / WhatsApp <span
                                            class="text-accent">*</span
                                        >
                                    </label>
                                    <div class="relative">
                                        <div
                                            class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5 text-white/40"
                                        >
                                            <svg
                                                xmlns="http://www.w3.org/2000/svg"
                                                class="h-4 w-4"
                                                viewBox="0 0 24 24"
                                                fill="none"
                                                stroke="currentColor"
                                                stroke-width="2"
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                            >
                                                <path
                                                    d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
                                                ></path>
                                            </svg>
                                        </div>
                                        <input
                                            id="contact-phone"
                                            name="phone"
                                            type="tel"
                                            placeholder="+58 412..."
                                            required
                                            class="w-full rounded-xl border border-white/15 bg-white/[0.04] pl-10 pr-4 py-3 text-sm text-white focus:border-accent focus:bg-white/[0.08] focus:ring-2 focus:ring-accent/40 outline-none transition-all duration-300 placeholder:text-white/30 hover:border-white/30"
                                        />
                                    </div>
                                </div>
                            </div>

                            <div class="grid gap-4 sm:grid-cols-2">
                                <!-- Empresa -->
                                <div class="space-y-1.5">
                                    <label
                                        for="contact-company"
                                        class="block text-xs font-bold uppercase tracking-wider text-purple-200/90 ml-1"
                                    >
                                        Empresa / Negocio <span
                                            class="text-white/40 text-[10px] font-normal lowercase"
                                            >(opcional)</span
                                        >
                                    </label>
                                    <div class="relative">
                                        <div
                                            class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5 text-white/40"
                                        >
                                            <svg
                                                xmlns="http://www.w3.org/2000/svg"
                                                class="h-4 w-4"
                                                viewBox="0 0 24 24"
                                                fill="none"
                                                stroke="currentColor"
                                                stroke-width="2"
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                            >
                                                <rect
                                                    width="16"
                                                    height="20"
                                                    x="4"
                                                    y="2"
                                                    rx="2"
                                                    ry="2"></rect>
                                                <path d="M9 22v-4h6v4"></path>
                                                <path d="M8 6h.01"></path>
                                                <path d="M16 6h.01"></path>
                                                <path d="M12 6h.01"></path>
                                                <path d="M12 10h.01"></path>
                                                <path d="M12 14h.01"></path>
                                                <path d="M16 10h.01"></path>
                                                <path d="M16 14h.01"></path>
                                                <path d="M8 10h.01"></path>
                                                <path d="M8 14h.01"></path>
                                            </svg>
                                        </div>
                                        <input
                                            id="contact-company"
                                            name="company"
                                            type="text"
                                            placeholder="Nombre de tu negocio"
                                            class="w-full rounded-xl border border-white/15 bg-white/[0.04] pl-10 pr-4 py-3 text-sm text-white focus:border-accent focus:bg-white/[0.08] focus:ring-2 focus:ring-accent/40 outline-none transition-all duration-300 placeholder:text-white/30 hover:border-white/30"
                                        />
                                    </div>
                                </div>

                                <!-- Interés / Plan -->
                                <div class="space-y-1.5">
                                    <label
                                        for="contact-interest"
                                        class="block text-xs font-bold uppercase tracking-wider text-purple-200/90 ml-1"
                                    >
                                        Me interesa
                                    </label>
                                    <div class="relative">
                                        <div
                                            class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5 text-white/40"
                                        >
                                            <svg
                                                xmlns="http://www.w3.org/2000/svg"
                                                class="h-4 w-4"
                                                viewBox="0 0 24 24"
                                                fill="none"
                                                stroke="currentColor"
                                                stroke-width="2"
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                            >
                                                <circle cx="12" cy="12" r="10"
                                                ></circle>
                                                <path d="m9 12 2 2 4-4"></path>
                                            </svg>
                                        </div>
                                        <select
                                            id="contact-interest"
                                            name="interest"
                                            class="w-full rounded-xl border border-white/15 bg-[#17073b] pl-10 pr-8 py-3 text-sm text-white focus:border-accent focus:bg-[#1f0a52] focus:ring-2 focus:ring-accent/40 outline-none transition-all duration-300 hover:border-white/30 cursor-pointer appearance-none"
                                        >
                                            <option
                                                value="Demostración guiada en vivo"
                                                class="bg-[#17073b] text-white"
                                                >Solicitar Demostración en vivo</option
                                            >
                                            <option
                                                value="Plan Básico ($25/mes)"
                                                class="bg-[#17073b] text-white"
                                                >Plan Básico ($25/mes)</option
                                            >
                                            <option
                                                value="Plan Pro Anual ($270/año)"
                                                class="bg-[#17073b] text-white"
                                                >Plan Pro Anual ($270/año) +
                                                Regalo Web</option
                                            >
                                            <option
                                                value="Consulta general o personalizada"
                                                class="bg-[#17073b] text-white"
                                                >Consulta General / Asesoría</option
                                            >
                                        </select>
                                        <div
                                            class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-3.5 text-white/40"
                                        >
                                            <svg
                                                class="w-4 h-4"
                                                fill="none"
                                                stroke="currentColor"
                                                viewBox="0 0 24 24"
                                            >
                                                <path
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                    stroke-width="2"
                                                    d="M19 9l-7 7-7-7"></path>
                                            </svg>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Mensaje -->
                            <div class="space-y-1.5">
                                <label
                                    for="contact-message"
                                    class="block text-xs font-bold uppercase tracking-wider text-purple-200/90 ml-1"
                                >
                                    Mensaje <span class="text-accent">*</span>
                                </label>
                                <textarea
                                    id="contact-message"
                                    name="message"
                                    rows="4"
                                    required
                                    placeholder="Cuéntanos brevemente sobre tu negocio o qué dudas tienes sobre SAVI..."
                                    class="w-full rounded-xl border border-white/15 bg-white/[0.04] px-4 py-3 text-sm text-white focus:border-accent focus:bg-white/[0.08] focus:ring-2 focus:ring-accent/40 outline-none transition-all duration-300 placeholder:text-white/30 hover:border-white/30 resize-none"
                                ></textarea>
                            </div>

                            <!-- Botón Enviar -->
                            <button
                                type="submit"
                                id="submit-btn"
                                class="group/btn relative flex h-14 w-full items-center justify-center rounded-xl bg-linear-to-r from-emerald-500 via-emerald-600 to-teal-600 text-base font-bold text-white shadow-[0_0_30px_rgba(16,185,129,0.35)] hover:shadow-[0_0_45px_rgba(16,185,129,0.6)] hover:brightness-110 active:scale-[0.98] transition-all duration-300 cursor-pointer overflow-hidden mt-1"
                            >
                                <span
                                    class="relative z-10 flex items-center gap-2.5 font-bold tracking-wide"
                                >
                                    <svg
                                        class="w-5 h-5 fill-current"
                                        viewBox="0 0 24 24"
                                    >
                                        <path
                                            d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.275.072.376-.044c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.086s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.099.824zm-3.394-10.416c-4.409 0-7.996 3.587-7.996 7.996 0 1.408.365 2.784 1.059 4.001l-1.096 4.003 4.129-1.083c1.178.643 2.506.983 3.904.984 4.409 0 7.996-3.587 7.996-7.996 0-4.409-3.587-7.996-7.996-7.996zm0 14.509c-1.246 0-2.463-.335-3.526-.968l-.253-.15-2.61.685.696-2.544-.165-.263c-.699-1.112-1.069-2.399-1.069-3.722 0-3.649 2.969-6.618 6.619-6.618 3.649 0 6.618 2.969 6.618 6.618 0 3.649-2.969 6.618-6.618 6.618z"
                                        ></path>
                                    </svg>
                                    <span id="submit-btn-text"
                                        >Enviar Mensaje a WhatsApp</span
                                    >
                                    <svg
                                        class="w-4 h-4 transition-transform duration-300 group-hover/btn:translate-x-1"
                                        fill="none"
                                        stroke="currentColor"
                                        viewBox="0 0 24 24"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                                    </svg>
                                </span>
                            </button>

                            <!-- Privacy / Assurance Note -->
                            <p
                                class="text-center text-[11px] sm:text-xs text-text-muted/80 flex items-center justify-center gap-1.5 pt-1"
                            >
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    class="h-3.5 w-3.5 text-emerald-400"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                >
                                    <rect
                                        width="18"
                                        height="11"
                                        x="3"
                                        y="11"
                                        rx="2"
                                        ry="2"></rect>
                                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                                </svg>
                                <span
                                    >Tus datos se transferirán directamente a tu
                                    WhatsApp listos para enviar. Sin
                                    intermediarios.</span
                                >
                            </p>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    const form = document.getElementById(
        "whatsapp-contact-form",
    ) as HTMLFormElement;
    const submitBtn = document.getElementById(
        "submit-btn",
    ) as HTMLButtonElement;
    const submitBtnText = document.getElementById(
        "submit-btn-text",
    ) as HTMLSpanElement;

    form?.addEventListener("submit", (e) => {
        e.preventDefault();

        const formData = new FormData(form);
        const name = ((formData.get("name") as string) || "").trim();
        const phone = ((formData.get("phone") as string) || "").trim();
        const company = ((formData.get("company") as string) || "").trim();
        const interest = ((formData.get("interest") as string) || "").trim();
        const message = ((formData.get("message") as string) || "").trim();

        const phoneNumber = "584247217176";

        let text = `👋 *¡Hola! Deseo más información sobre el sistema SAVI.*\n\n`;
        text += `👤 *Nombre:* ${name}\n`;
        if (phone) {
            text += `📱 *Teléfono / WhatsApp:* ${phone}\n`;
        }
        if (company) {
            text += `🏢 *Empresa:* ${company}\n`;
        }
        if (interest) {
            text += `🎯 *Interés:* ${interest}\n`;
        }
        text += `\n💬 *Mensaje:*\n${message}\n`;

        const whatsappUrl = `https://wa.me/${phoneNumber}?text=${encodeURIComponent(text)}`;

        // Feedback visual en el botón
        if (submitBtnText) {
            const originalText = submitBtnText.textContent;
            submitBtnText.textContent = "Abriendo WhatsApp...";
            submitBtn?.classList.add("opacity-90");

            setTimeout(() => {
                submitBtnText.textContent = originalText;
                submitBtn?.classList.remove("opacity-90");
            }, 3000);
        }

        // Abrir WhatsApp en nueva pestaña
        window.open(whatsappUrl, "_blank");
        form.reset();
    });
</script>
