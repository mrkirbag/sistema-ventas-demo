---
const phoneNumber = "584247217176";
const demoMessage = encodeURIComponent(
    "Hola! 👋 Me gustaría solicitar una demostración del sistema administrativo.",
);
const whatsappDemoUrl = `https://wa.me/${phoneNumber}?text=${demoMessage}`;
---

<section
    class="relative min-h-screen flex flex-col items-center justify-center overflow-hidden snap-start pt-20 pb-8 sm:pt-28 sm:pb-16"
    id="hero"
>
    <!-- Background Tech Grid Pattern with Vignette Mask -->
    <div
        class="pointer-events-none absolute inset-0 bg-[linear-gradient(to_right,#ffffff07_1px,transparent_1px),linear-gradient(to_bottom,#ffffff07_1px,transparent_1px)] bg-[size:3.5rem_3.5rem] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_40%,#000_60%,transparent_100%)] opacity-70"
    >
    </div>

    <!-- Multi-layered Ambient Lights & Glows -->
    <div class="pointer-events-none absolute inset-0 overflow-hidden">
        <!-- Top Central Nebula -->
        <div
            class="absolute -top-24 left-1/2 -translate-x-1/2 w-[650px] sm:w-[900px] h-[450px] bg-linear-to-b from-accent/25 via-tertiary/15 to-transparent blur-[120px] rounded-full"
        >
        </div>

        <!-- Left Lateral Glow -->
        <div
            class="absolute top-1/4 -left-40 w-[420px] h-[420px] bg-tertiary/15 blur-[140px] rounded-full"
        >
        </div>

        <!-- Right Lateral Glow -->
        <div
            class="absolute top-1/3 -right-40 w-[420px] h-[420px] bg-accent/15 blur-[140px] rounded-full"
        >
        </div>
    </div>

    <div
        class="mx-auto max-w-5xl px-4 sm:px-6 relative z-10 text-center my-auto flex flex-col items-center"
    >
        <!-- Central Glow behind content -->
        <div
            class="pointer-events-none absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[550px] h-[320px] bg-accent/10 blur-[110px] rounded-full -z-10"
        >
        </div>

        <!-- Eyebrow Pill / Badge -->
        <div
            class="inline-flex items-center gap-2 px-3.5 py-1 sm:px-4 sm:py-1.5 rounded-full border border-accent/35 bg-accent/10 backdrop-blur-md shadow-[0_0_20px_rgba(168,85,247,0.2)] mb-4 sm:mb-6 transition-all duration-300 hover:border-accent/60 hover:shadow-[0_0_30px_rgba(168,85,247,0.35)]"
        >
            <span class="flex h-2 w-2 relative">
                <span
                    class="animate-ping absolute inline-flex h-full w-full rounded-full bg-accent opacity-75"
                ></span>
                <span
                    class="relative inline-flex rounded-full h-2 w-2 bg-accent shadow-[0_0_8px_rgba(168,85,247,0.9)]"
                ></span>
            </span>
            <span
                class="text-[11px] sm:text-sm font-bold uppercase tracking-wider text-accent drop-shadow-[0_0_10px_rgba(168,85,247,0.5)]"
            >
                Gestión Comercial & Inventario
            </span>
        </div>

        <!-- Main Headline -->
        <h1
            class="text-3xl sm:text-5xl md:text-6xl lg:text-[4rem] font-extrabold tracking-tight text-white mb-4 sm:mb-6 leading-[1.18] max-w-4xl"
        >
            Tus finanzas bajo control <br class="hidden sm:inline" />
            <span class="text-white/95">con </span><span
                class="text-transparent bg-clip-text bg-linear-to-r from-accent via-purple-300 to-tertiary drop-shadow-[0_0_35px_rgba(168,85,247,0.55)] inline"
            >
                Precisión Absoluta
            </span>
        </h1>

        <!-- Subtitle / Value Proposition -->
        <p
            class="mx-auto max-w-2xl text-sm sm:text-lg md:text-xl text-text-muted font-normal mb-6 sm:mb-10 leading-relaxed px-2"
        >
            Diseñada para impulsar la rentabilidad de tu negocio
        </p>

        <!-- CTA Buttons -->
        <div
            class="flex flex-col sm:flex-row items-center justify-center gap-3.5 sm:gap-5 w-full sm:w-auto"
        >
            <!-- Primary Action: Visualiza el Demo -->
            <a
                class="relative group h-12 sm:h-14 w-full sm:w-auto px-7 sm:px-10 rounded-xl bg-linear-to-r from-accent via-purple-600 to-tertiary font-bold text-white text-base sm:text-lg shadow-[0_0_30px_rgba(168,85,247,0.45)] hover:shadow-[0_0_40px_rgba(168,85,247,0.7)] hover:scale-[1.03] active:scale-[0.98] transition-all duration-300 flex items-center justify-center gap-2.5 cursor-pointer overflow-hidden border border-white/20"
                href="/login"
            >
                <div
                    class="absolute inset-0 -translate-x-full group-hover:translate-x-full transition-transform duration-1000 bg-linear-to-r from-transparent via-white/20 to-transparent"
                >
                </div>
                <span>Visualiza el Demo</span>
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="2.5"
                    stroke="currentColor"
                    class="w-5 h-5 transition-transform duration-300 group-hover:translate-x-1"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"></path>
                </svg>
            </a>

            <!-- Secondary Action: WhatsApp / Información -->
            <a
                class="group h-12 sm:h-14 w-full sm:w-auto px-7 sm:px-10 rounded-xl border border-white/15 bg-white/[0.05] hover:bg-white/[0.1] hover:border-accent/40 font-semibold text-white text-base sm:text-lg hover:scale-[1.03] active:scale-[0.98] transition-all duration-300 backdrop-blur-md flex items-center justify-center gap-3 cursor-pointer shadow-[0_4px_20px_rgba(0,0,0,0.3)]"
                href={whatsappDemoUrl}
                target="_blank"
                rel="noopener noreferrer"
            >
                <!-- WhatsApp SVG icon -->
                <svg
                    class="w-5 h-5 text-emerald-400 group-hover:scale-110 transition-transform duration-300"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                >
                    <path
                        d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.669-.699c.969.585 1.961.882 2.791.882 3.181 0 5.767-2.586 5.768-5.766 0-3.18-2.587-5.768-5.768-5.768zm0 10.455c-.777 0-1.684-.265-2.428-.711l-.174-.103-1.802.472.482-1.758-.113-.182a4.674 4.674 0 0 1-.722-2.397c0-2.613 2.127-4.74 4.757-4.74 2.631 0 4.757 2.127 4.757 4.74s-2.126 4.679-4.757 4.679z"
                    ></path>
                    <path
                        d="M12.012 2C6.486 2 2 6.486 2 12.012c0 1.999.593 3.864 1.621 5.438L2 22l4.679-1.597a9.96 9.96 0 0 0 5.333 1.545C17.538 21.948 22 17.462 22 11.936 22 6.486 17.514 2 12.012 2zm0 18.064c-1.745 0-3.376-.51-4.764-1.391l-.341-.219-3.535 1.206 1.229-3.447-.239-.381a8.033 8.033 0 0 1-1.34-4.821c0-4.453 3.623-8.076 8.076-8.076 4.453 0 8.076 3.623 8.076 8.076 0 4.453-3.623 8.052-8.076 8.052z"
                    ></path>
                </svg>
                <span>Información</span>
            </a>
        </div>

        <!-- Scroll Explorer Indicator (In-flow with subtle bounce) -->
        <div
            class="hidden md:flex flex-col items-center mt-6 opacity-60 hover:opacity-100 transition-opacity"
        >
            <a
                href="#beneficios"
                class="flex flex-col items-center text-text-muted hover:text-accent transition-colors group"
                aria-label="Ir a sección de beneficios"
            >
                <span
                    class="text-[10px] uppercase tracking-widest font-semibold text-text-muted/60 group-hover:text-accent transition-colors"
                >
                    Explorar
                </span>
                <svg
                    class="w-4 h-4 animate-bounce mt-1 text-accent/80"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M19.5 8.25l-7.5 7.5-7.5-7.5"></path>
                </svg>
            </a>
        </div>
    </div>
</section>
