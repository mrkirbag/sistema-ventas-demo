---
import Layout from '../layouts/Layout.astro';
import { verificarToken } from '@/utils/auth.js';

const usuario = verificarToken(Astro.request);
if (!usuario) {
    return Astro.redirect('/login');
}

const fechaActual = new Date().toLocaleDateString("es-VE", {
    timeZone: "America/Caracas",
    year: "numeric",
    month: "2-digit",
    day: "2-digit"
}).split('/').reverse().join('-');
---

<Layout>
    <header class="page-header">
        <p class="eyebrow">Gestión comercial</p>
        <h1>Cotizaciones</h1>
        <p class="page-intro">Consulta las cotizaciones del día, revisa el detalle de cada una y agrega nuevas cotizaciones.</p>
    </header>

    <div class="page-toolbar cotizaciones-toolbar">
        <div class="toolbar-actions">
            <div class="btn-add_container">
                <a class="btn-add" href="/cotizaciones/agregar">Agregar cotización</a>
            </div>

            <div class="btn-add_container imprimir-container" id="imprimirContainer" style="display: none;">
                <a class="btn-add" id="imprimir">Imprimir reporte</a>
            </div>
        </div>

        <div class="filtros-cotizaciones">
            <div class="filtro-fecha">
                <label class="filtro-fecha_label" for="filtroFecha">Fecha de consulta</label>
                <div class="input-busqueda_container fecha-filtro">
                    <input type="date" id="filtroFecha" value={fechaActual} />
                </div>
            </div>

            <div class="filtro-cliente">
                <label class="filtro-fecha_label" for="inputBusqueda">Cliente</label>
                <div class="input-busqueda_container">
                    <input type="text" id="inputBusqueda" placeholder="Nombre, cédula o teléfono..." />
                </div>
            </div>
        </div>
    </div>

    <section class="cotizaciones-summary-card" aria-live="polite">
        <div class="summary-icon" aria-hidden="true">$</div>
        <div>
            <p class="summary-eyebrow">Cotizaciones del día</p>
            <p class="summary-text" id="resumenCotizaciones">Selecciona una fecha para ver las cotizaciones registradas.</p>
        </div>
    </section>

    <div class="table-wrap">
        <table id="tabla">
            <thead id="tablaCotizacionesHead" style="display: none;">
                <tr>
                    <th>Fecha</th>
                    <th>Cliente</th>
                    <th>Total</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody id="listaCotizaciones">
            </tbody>
        </table>
    </div>

    <div id="mensaje"></div>
    <div id="overlay" class="overlay oculto">
        <div id="modal" class="modal"></div>
    </div>
</Layout>

<style>
    .filtros-cotizaciones {
        display: flex;
        flex-wrap: wrap;
        align-items: end;
        justify-content: flex-end;
        gap: 0.75rem 1rem;
        margin-left: auto;
        flex: 1 1 280px;
    }

    .filtro-fecha,
    .filtro-cliente {
        display: grid;
        gap: 0.35rem;
        flex: 0 1 220px;
        min-width: min(100%, 200px);
        justify-items: stretch;
        align-self: center;
    }

    .filtro-cliente {
        flex: 1 1 240px;
        max-width: 360px;
    }

    .filtro-fecha_label {
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--secondary-color);
    }

    .fecha-filtro,
    .filtro-cliente .input-busqueda_container {
        margin: 0;
        padding: 0;
        justify-content: stretch;
        height: auto;
        min-height: 0;
        align-items: stretch;
        width: 100%;
    }

    .fecha-filtro input,
    .filtro-cliente input {
        width: 100%;
        max-width: none;
        margin: 0;
    }

    .imprimir-container {
        min-width: 0;
    }

    .cotizaciones-summary-card {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1rem 1.15rem;
        border-radius: var(--radius-lg);
        background: linear-gradient(135deg, rgba(var(--secondary-rgb), 0.06), rgba(217, 209, 236, 0.42));
        border: 1px solid rgba(var(--secondary-rgb), 0.1);
        box-shadow: var(--shadow-card);
    }

    .summary-icon {
        display: grid;
        place-items: center;
        width: 52px;
        height: 52px;
        border-radius: 16px;
        background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
        color: #fff;
        font-family: "Archivo Black", sans-serif;
        font-size: 1.35rem;
        flex-shrink: 0;
        box-shadow: 0 10px 22px rgba(var(--primary-rgb), 0.2);
    }

    .summary-eyebrow {
        margin: 0 0 0.2rem;
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--secondary-color);
    }

    .summary-text {
        margin: 0;
        font-size: 0.95rem;
        font-weight: 600;
        color: var(--primary-strong);
        line-height: 1.5;
    }

    :global(.monto-usd) {
        font-weight: 700;
        color: var(--primary-strong);
    }

    :global(.monto-cop) {
        font-size: 0.78rem;
        color: var(--text-muted);
    }

    @media (max-width: 768px) {
        .page-header {
            margin-bottom: 0.15rem;
        }

        .cotizaciones-toolbar {
            gap: 0.65rem;
            padding-bottom: 0.15rem;
        }

        .cotizaciones-toolbar .toolbar-actions {
            gap: 0.55rem;
        }

        .cotizaciones-toolbar .filtros-cotizaciones {
            order: -1;
            width: 100%;
            margin-left: 0;
            flex-direction: column;
            align-items: stretch;
            gap: 0.55rem;
        }

        .cotizaciones-toolbar .filtro-fecha,
        .cotizaciones-toolbar .filtro-cliente {
            width: 100%;
            max-width: none;
            flex: 1 1 auto;
            min-width: 0;
            justify-items: stretch;
            gap: 0.4rem;
        }

        .cotizaciones-toolbar .fecha-filtro input,
        .cotizaciones-toolbar .filtro-cliente input {
            display: block;
            width: 100%;
            max-width: none;
            height: 36px;
            min-height: 36px;
            max-height: 36px;
            padding: 0 0.7rem;
            font-size: 16px;
            line-height: normal;
            box-sizing: border-box;
        }

        .cotizaciones-toolbar + .cotizaciones-summary-card {
            margin-top: 0.35rem;
        }

        .cotizaciones-summary-card {
            align-items: flex-start;
            padding: 0.9rem 1rem;
        }

        .cotizaciones-summary-card + .table-wrap {
            margin-top: 0.45rem;
        }

        .table-wrap + #mensaje:not(:empty) {
            margin-top: 0.5rem;
        }
    }
</style>

<script>
    import { noRegistros } from "@/utils/helpers/mensajes.js";
    import { cambioUSDaCOP } from "@/utils/helpers/cambioMoneda.js";
    import { formatearFecha } from "@/utils/helpers/formateoFecha.js";
    import { imprimir } from '@/utils/helpers/imprimir.js';

    interface Cotizacion {
        id: number;
        fecha: string;
        cliente_nombre: string;
        cliente_cedula_rif: string;
        cliente_telefono: string;
        cliente_direccion?: string;
        total: number;
    }

    let cotizacionesCargadas: Cotizacion[] = [];
    let tasaActual = 1;

    function actualizarResumen(cantidadVisible: number, cantidadTotal: number, fecha: string, hayFiltro: boolean) {
        const resumen = document.getElementById('resumenCotizaciones') as HTMLParagraphElement;
        if (!resumen) return;

        if (cantidadTotal === 0) {
            resumen.textContent = `No hay cotizaciones registradas para el ${fecha}.`;
            return;
        }

        if (hayFiltro) {
            if (cantidadVisible === 0) {
                resumen.textContent = `Ninguna cotización coincide con la búsqueda (${cantidadTotal} en el ${fecha}).`;
                return;
            }

            const visible = cantidadVisible === 1 ? '1 coincidencia' : `${cantidadVisible} coincidencias`;
            resumen.textContent = `${visible} de ${cantidadTotal} cotizaciones para el ${fecha}.`;
            return;
        }

        const texto = cantidadTotal === 1 ? '1 cotización registrada' : `${cantidadTotal} cotizaciones registradas`;
        resumen.textContent = `${texto} para el ${fecha}.`;
    }

    function coincideCliente(cotizacion: Cotizacion, termino: string) {
        const filtro = termino.trim().toLowerCase();
        if (!filtro) return true;

        const campos = [
            cotizacion.cliente_nombre,
            cotizacion.cliente_cedula_rif,
            cotizacion.cliente_telefono,
            cotizacion.cliente_direccion,
        ];

        return campos.some((campo) => String(campo || '').toLowerCase().includes(filtro));
    }

    function renderCotizaciones(lista: Cotizacion[]) {
        const tablaHead = document.getElementById('tablaCotizacionesHead') as HTMLTableSectionElement;
        const tbody = document.getElementById('listaCotizaciones') as HTMLTableSectionElement;
        const imprimirContainer = document.getElementById('imprimirContainer') as HTMLDivElement;
        const filtroFecha = document.getElementById('filtroFecha') as HTMLInputElement;
        const inputBusqueda = document.getElementById('inputBusqueda') as HTMLInputElement;
        const fechaFormateadaResumen = formatearFecha(filtroFecha.value);
        const hayFiltro = Boolean(inputBusqueda.value.trim());

        tbody.innerHTML = '';

        if (cotizacionesCargadas.length === 0) {
            imprimirContainer.style.display = 'none';
            tablaHead.style.display = 'none';
            actualizarResumen(0, 0, fechaFormateadaResumen, hayFiltro);
            noRegistros('No hay cotizaciones registradas para esa fecha');
            return;
        }

        if (lista.length === 0) {
            imprimirContainer.style.display = 'none';
            tablaHead.style.display = 'none';
            actualizarResumen(0, cotizacionesCargadas.length, fechaFormateadaResumen, hayFiltro);
            noRegistros('No hay cotizaciones que coincidan con la búsqueda');
            return;
        }

        noRegistros('');
        tablaHead.style.display = 'table-header-group';
        imprimirContainer.style.display = 'inline-flex';
        actualizarResumen(lista.length, cotizacionesCargadas.length, fechaFormateadaResumen, hayFiltro);

        lista.forEach((cotizacion) => {
            const fechaFormateada = formatearFecha(cotizacion.fecha);
            const totalUsd = Number(cotizacion.total);
            const totalCOP = Math.ceil(totalUsd * tasaActual);

            const tr = document.createElement('tr');
            tr.innerHTML = `
                <td data-label="Fecha">${fechaFormateada}</td>
                <td data-label="Cliente">
                    <strong>${cotizacion.cliente_nombre.toUpperCase()}</strong><br />
                    <span class="monto-cop">${cotizacion.cliente_cedula_rif.toUpperCase()} · ${cotizacion.cliente_telefono}</span>
                </td>
                <td data-label="Total">
                    <span class="monto-usd">${totalUsd.toFixed(2)} USD</span>
                    <br />
                    <span class="monto-cop">${totalCOP} COP</span>
                </td>
            `;

            const tdAcciones = document.createElement('td');
            tdAcciones.classList.add('acciones');

            const btnVerInfo = document.createElement('button');
            btnVerInfo.type = 'button';
            btnVerInfo.classList.add('btn-editar');
            btnVerInfo.textContent = 'VER INFO';
            btnVerInfo.onclick = () => {
                window.location.href = `/cotizaciones/${cotizacion.id}`;
            };

            tdAcciones.appendChild(btnVerInfo);
            tr.appendChild(tdAcciones);
            tbody.appendChild(tr);
        });
    }

    function aplicarFiltroCliente() {
        const inputBusqueda = document.getElementById('inputBusqueda') as HTMLInputElement;
        const filtradas = cotizacionesCargadas.filter((cotizacion) =>
            coincideCliente(cotizacion, inputBusqueda.value)
        );
        renderCotizaciones(filtradas);
    }

    async function cargarCotizaciones() {
        const filtroFecha = document.getElementById('filtroFecha') as HTMLInputElement;

        try {
            const res = await fetch(`/api/cotizaciones?fecha=${filtroFecha.value}`);
            const data = await res.json();

            if (res.status === 202 || !Array.isArray(data)) {
                cotizacionesCargadas = [];
                renderCotizaciones([]);
                return;
            }

            cotizacionesCargadas = data;
            tasaActual = await cambioUSDaCOP();
            aplicarFiltroCliente();
        } catch (err) {
            console.error('Error al cargar cotizaciones:', err);
        }
    }

    document.addEventListener('DOMContentLoaded', () => {
        const filtroFecha = document.getElementById('filtroFecha') as HTMLInputElement;
        const inputBusqueda = document.getElementById('inputBusqueda') as HTMLInputElement;

        filtroFecha.addEventListener('input', cargarCotizaciones);
        inputBusqueda.addEventListener('input', aplicarFiltroCliente);
        cargarCotizaciones();
    });

    const btnImprimir = document.querySelector('#imprimir') as HTMLAnchorElement;

    btnImprimir.addEventListener('click', () => {
        const tabla = document.getElementById('tabla');
        if (!tabla) return;

        const tablaClon: any = tabla.cloneNode(true);

        for (const fila of tablaClon.rows) {
            if (fila.cells.length > 0) {
                fila.deleteCell(fila.cells.length - 1);
            }
        }

        imprimir({
            titulo: 'Impresión de cotizaciones',
            tituloDocumento: 'REPORTE DE COTIZACIONES DEL DIA',
            contenido: tablaClon.outerHTML,
        });
    });
</script>
