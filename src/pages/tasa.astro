---
import Layout from '../layouts/Layout.astro';
import { verificarToken } from '../utils/auth.js';

const usuario = verificarToken(Astro.request);
if (!usuario) {
    return Astro.redirect('/login');
}
---

<Layout>
    <header class="page-header">
        <p class="eyebrow">Configuración</p>
        <h1>Tasas del día</h1>
        <p class="page-intro">Registra cuántos pesos y bolívares equivalen a 1 USD. La conversión de cada comercio usa la moneda base de sus precios.</p>
    </header>

    <section class="tasas-resumen">
        <article>
            <p class="eyebrow">USD → COP</p>
            <p><span id="tasaCopTexto">—</span> COP</p>
        </article>
        <article>
            <p class="eyebrow">USD → Bs</p>
            <p><span id="tasaBsTexto">—</span> Bs</p>
        </article>
    </section>

    <section class="form-container page-form">
        <form id="formulario">
            <div class="form-field">
                <label for="tasaCop">Tasa COP (pesos por 1 USD)</label>
                <input type="text" id="tasaCop" name="tasaCop" placeholder="Ej. 4000" required />
            </div>
            <div class="form-field">
                <label for="tasaBs">Tasa Bs (bolívares por 1 USD)</label>
                <input type="text" id="tasaBs" name="tasaBs" placeholder="Ej. 36.50" required />
            </div>
            <div class="form-actions">
                <button type="submit">Actualizar tasas</button>
            </div>
        </form>
    </section>
        
    <div id="mensaje"></div>
    <div id="overlay" class="overlay oculto"> 
        <div id="modal" class="modal"></div>
    </div>
</Layout>

<script>
    import { mostrarError, mostrarMensaje } from '@/utils/helpers/mensajes.js';
    import { invalidarCacheTasa } from '@/utils/helpers/cambioMoneda.js';

    async function parseApiResponse(response: Response) {
        const contentType = response.headers.get('content-type') || '';

        if (contentType.includes('application/json')) {
            return response.json();
        }

        const text = await response.text();
        return { error: text || 'Error inesperado del servidor' };
    }

    function numeroInput(valor: string) {
        return parseFloat(valor.replace(',', '.'));
    }

    document.addEventListener('DOMContentLoaded', async () => {
        const tasaCopTexto = document.getElementById('tasaCopTexto') as HTMLElement;
        const tasaBsTexto = document.getElementById('tasaBsTexto') as HTMLElement;
        const inputTasaCop = document.getElementById('tasaCop') as HTMLInputElement;
        const inputTasaBs = document.getElementById('tasaBs') as HTMLInputElement;

        try {
            const response = await fetch('/api/tasa');

            if (response.status === 204) {
                const data = await response.json().catch(() => ({}));
                mostrarMensaje(data.message || 'No hay tasa registrada');
                return;
            }

            const data = await parseApiResponse(response);

            if (!response.ok) {
                mostrarError(data.error || data.message || 'Error al cargar las tasas del día');
                return;
            }

            const cop = data.cop ?? data.valor ?? '';
            const bs = data.bs ?? '';

            tasaCopTexto.textContent = cop === '' ? '—' : String(cop);
            tasaBsTexto.textContent = bs === '' || Number(bs) === 0 ? '—' : String(bs);
            inputTasaCop.value = cop === '' ? '' : String(cop);
            inputTasaBs.value = bs === '' || Number(bs) === 0 ? '' : String(bs);

        } catch (error : any) {
            mostrarError(error.message || 'Error al cargar las tasas del día');
        }
    });
    
    const formulario = document.getElementById('formulario') as HTMLFormElement;

    formulario?.addEventListener('submit', async (event : SubmitEvent) => { 
        
        event.preventDefault();

        const cop = numeroInput((document.getElementById('tasaCop') as HTMLInputElement).value);
        const bs = numeroInput((document.getElementById('tasaBs') as HTMLInputElement).value);

        if (!Number.isFinite(cop) || cop <= 0) {
            mostrarError('La tasa COP debe ser un número mayor a 0');
            return;
        }

        if (!Number.isFinite(bs) || bs < 0) {
            mostrarError('La tasa Bs debe ser un número mayor o igual a 0');
            return;
        }

        try {
            const response = await fetch('/api/tasa', {
                method: 'PUT',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ cop, bs })
            });

            const data = await parseApiResponse(response);

            if (!response.ok) {
                mostrarError(data.error || data.message || 'Error al actualizar las tasas');
                return;
            }

            invalidarCacheTasa();
            mostrarMensaje('Tasas actualizadas correctamente');
            setTimeout(() => {
                window.location.reload();
            }, 1000);

        } catch (error : any) {
            mostrarError(error.message);
        }
    });
</script>

<style>
    .tasas-resumen {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1rem;
        margin: 1.25rem 0;
    }

    .tasas-resumen article {
        padding: 1.1rem 1.2rem;
        border-radius: 18px;
        background: rgba(255, 255, 255, 0.82);
        border: 1px solid rgba(var(--secondary-rgb), 0.08);
        box-shadow: 0 18px 32px rgba(var(--primary-rgb), 0.08);
    }

    .tasas-resumen p:last-child {
        margin: 0.35rem 0 0;
        font-size: 1.35rem;
        font-weight: 700;
        color: var(--secondary-color);
    }

    @media (max-width: 720px) {
        .tasas-resumen {
            grid-template-columns: 1fr;
        }
    }
</style>
