---
import Layout from '../../layouts/Layout.astro';
import { verificarToken } from '@/utils/auth.js';
import { obtenerMonedaBase } from '@/utils/helpers/tasas.js';

const monedaBase = obtenerMonedaBase();

const usuario = verificarToken(Astro.request);
if (!usuario) {
    return Astro.redirect('/login');
}

const fechaVenezuela = new Intl.DateTimeFormat('es-VE', {
        timeZone: 'America/Caracas',
        year: 'numeric',
        month: '2-digit',
        day: '2-digit'
    }).format(new Date());

const [dia, mes, ano] = fechaVenezuela.split('/');
const fechaCompleta = `${ano}-${mes}-${dia}`;
---

<Layout>
    <header class="page-header">
        <p class="eyebrow">Gestión comercial</p>
        <h1>Nueva venta</h1>
        <p class="page-intro">Agrega productos al carrito, confirma el detalle y completa la venta con el cliente y el tipo de pago.</p>
    </header>

    <div class="btn-add_container">
        <a class="btn-add" href="/ventas">Regresar</a>
    </div>

    <main class="venta-flow">
        <section class="venta-panel">
            <div class="panel-heading">
                <span class="step-badge">1</span>
                <div>
                    <p class="eyebrow">Productos</p>
                    <h2>Agregar al carrito</h2>
                </div>
            </div>

            <section class="form-container page-form venta-form">
                <form onsubmit="return false;">
                    <div class="form-field">
                        <label for="fecha">Fecha de venta</label>
                        <input type="date" name="fecha" id="fecha" value={fechaCompleta}/>
                    </div>

                    <div id="productos-container" class="producto-module">
                        <div class="form-field producto-module_search">
                            <label for="busquedaProductos">Buscar producto</label>
                            <input
                                type="text"
                                id="busquedaProductos"
                                placeholder="Nombre o codigo del producto"
                                autocomplete="off"
                            />
                        </div>

                        <div class="form-field producto-module_select">
                            <label for="productoSelect">Producto</label>
                            <select name="producto" id="productoSelect"></select>
                        </div>

                        <div class="form-field">
                            <label for="cantidad">Cantidad</label>
                            <input type="text" id="cantidad" placeholder="Ej. 2"/>
                        </div>

                        <div class="form-field">
                            <label for="precio">Precio por unidad ({monedaBase})</label>
                            <input type="text" id="precio" placeholder={monedaBase === 'COP' ? '0' : '0.00'}/>
                            <span id="precioReferencia" class="precio-referencia">Referencia: —</span>
                        </div>

                        <div class="form-field" id="panelSerialesVenta" style="display: none; grid-column: 1 / -1;">
                            <label>Seleccionar Seriales</label>
                            <p style="font-size: 0.8rem; color: var(--text-muted); margin: 0 0 0.5rem;">Busca y selecciona los seriales (se irán agregando abajo).</p>
                            
                            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; align-items: end; margin-bottom: 0.5rem;">
                                <div class="form-field" style="margin-bottom: 0;">
                                    <label for="busquedaSeriales" style="font-size: 0.8rem;">Filtro de búsqueda</label>
                                    <input type="text" id="busquedaSeriales" placeholder="Ej. ABC12..." autocomplete="off">
                                </div>
                                <div class="form-field" style="margin-bottom: 0; position: relative;">
                                    <label for="dropdownSeriales" style="font-size: 0.8rem;">Seleccionar serial</label>
                                    <select id="dropdownSeriales"></select>
                                </div>
                            </div>

                            <div id="listaSerialesVenta" class="serial-tags-container" style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.85rem;"></div>
                        </div>

                        <div class="form-actions producto-module_actions">
                            <button type="button" id="agregarProducto">Agregar producto</button>
                        </div>
                    </div>
                </form>
            </section>
        </section>

        <section class="venta-panel invoice-table-card">
            <div class="table-heading">
                <div>
                    <p class="eyebrow">Detalle</p>
                    <h2>Productos seleccionados</h2>
                </div>
            </div>

            <div class="table-wrap">
                <table>
                    <thead id="headerTablaProductos" style="opacity: 0;">
                        <tr>
                            <th>Producto</th>
                            <th>Precio por unidad</th>
                            <th>Cantidad</th>
                            <th>Subtotal</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody id="listaProductos">
                    </tbody>
                </table>
            </div>
        </section>

        <div class="confirm-step">
            <button id="btnConfirmacion" class="btn-confirmar" disabled style="display: none;">
                Continuar con la venta
            </button>
        </div>

        <section class="form-container page-form venta-panel checkout-panel" id="moduloDatosCompletar" style="display: none;">
            <div class="panel-heading">
                <span class="step-badge">2</span>
                <div>
                    <p class="eyebrow">Finalizar</p>
                    <h2>Datos de la venta</h2>
                </div>
            </div>

            <form class="checkout-form" onsubmit="return false;">
                <div class="form-field">
                    <label for="busquedaClientes">Buscar cliente</label>
                    <input type="text" id="busquedaClientes" placeholder="Nombre, cédula o RIF" autocomplete="off" />
                </div>

                <div class="form-field select-container password-container">
                    <label for="cliente">Cliente</label>
                    <select name="cliente" id="cliente"></select>
                    <span class="btn-cliente" id="abrirMenuClienteNuevo" title="Registrar nuevo cliente">+</span>
                </div>
                
                <div id="infoCreditoCliente" style="display: none; grid-column: 1 / -1; padding: 0.8rem; background: rgba(234, 179, 8, 0.1); border: 1px solid rgba(234, 179, 8, 0.3); border-radius: 8px; color: #854d0e; font-size: 0.9rem; font-weight: 600; margin-bottom: 0.5rem;">
                    El cliente tiene un saldo a favor de <strong id="montoCreditoCliente">0.00</strong> en notas de crédito. Puedes usarlo en la sección de pagos seleccionando "Nota de crédito" en USD.
                </div>

                <div id="moduloAgregarClienteNuevo" class="cliente-nuevo-panel" style="display: none;">
                    <p class="cliente-nuevo_title">Registrar cliente no existente</p>
                    <div class="form-field">
                        <label for="clienteNuevoNombre">Nombre y apellido</label>
                        <input type="text" name="clienteNuevoNombre" id="clienteNuevoNombre" placeholder="Ej. Carlos Pérez" maxlength="80" autocomplete="off" />
                    </div>
                    <div class="form-field">
                        <label for="clienteNuevoCedula">Cédula o RIF</label>
                        <input type="text" name="clienteNuevoCedula" id="clienteNuevoCedula" placeholder="Ej. 12345678 o J-12345678-9" maxlength="15" autocomplete="off" />
                    </div>
                    <div class="form-field">
                        <label for="clienteNuevoTelefono">Teléfono</label>
                        <input type="text" name="clienteNuevoTelefono" id="clienteNuevoTelefono" placeholder="Ej. 04141234567" maxlength="20" autocomplete="off" />
                    </div>
                    <div class="form-actions">
                        <button type="button" id="btnAgregarClienteNuevo">Registrar cliente</button>
                    </div>
                </div>

                <div class="form-field" id="tipoPago-container">
                    <label for="tipoPago">Tipo de pago</label>
                    <select name="tipoPago" id="tipoPago">
                        <option value="">Selecciona el tipo de pago</option>
                        <option value="contado">De contado</option>
                        <option value="credito">A crédito</option>
                    </select>
                </div>

                <div id="moduloPagosVenta" class="pagos-venta-panel" hidden>
                    <p class="pagos-venta_title">Métodos de pago</p>
                    <p class="pagos-venta_hint">Puedes combinar USD, COP y Bs. El total cubierto debe igualar la venta.</p>

                    <div class="pagos-venta_form">
                        <div class="form-field">
                            <label for="pagoMoneda">Moneda</label>
                            <select id="pagoMoneda"></select>
                        </div>
                        <div class="form-field">
                            <label for="pagoMetodo">Método</label>
                            <select id="pagoMetodo"></select>
                        </div>
                        <div class="form-field">
                            <label for="pagoMonto">Monto recibido</label>
                            <input type="text" id="pagoMonto" inputmode="decimal" placeholder="0" autocomplete="off" />
                        </div>
                        <div class="form-actions pagos-venta_add">
                            <button type="button" id="btnAgregarPago">Agregar pago</button>
                        </div>
                    </div>

                    <div class="table-wrap pagos-venta_tabla" id="pagosVentaTablaWrap" hidden>
                        <table>
                            <thead>
                                <tr>
                                    <th>Método</th>
                                    <th>Recibido</th>
                                    <th>Equivalente</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody id="listaPagosVenta"></tbody>
                        </table>
                    </div>

                    <div class="pagos-venta_resumen" id="pagosVentaResumen">
                        <p>Cubierto: <strong id="pagosCubierto">—</strong></p>
                        <p>Falta: <strong id="pagosFalta">—</strong></p>
                    </div>
                </div>

                <p class="pagos-venta_credito" id="avisoPagoCredito" hidden>En ventas a crédito el ingreso se registra cuando se abona.</p>

                <div class="total-box checkout-total">
                    <p class="total-box_label">Total de la venta</p>
                    <p id="totalDeVenta" class="total-box_amount">—</p>
                </div>

                <div class="form-actions checkout-actions">
                    <button id="btnFinalizar" type="button">Confirmar venta</button>
                </div>
            </form>
        </section>
    </main>

    <div id="overlay" class="overlay oculto"> 
        <div id="modal" class="modal"></div>
    </div>
</Layout>

<style>
    .venta-flow {
        display: flex;
        flex-direction: column;
        gap: 1.2rem;
    }

    .venta-panel,
    .invoice-table-card {
        border-radius: 22px;
        background: rgba(255, 255, 255, 0.82);
        border: 1px solid rgba(var(--secondary-rgb), 0.08);
        box-shadow: 0 18px 32px rgba(var(--primary-rgb), 0.08);
    }

    .venta-panel {
        padding: 1.15rem;
    }

    .panel-heading {
        display: flex;
        align-items: center;
        gap: 0.9rem;
        margin-bottom: 1rem;
    }

    .step-badge {
        display: grid;
        place-items: center;
        width: 42px;
        height: 42px;
        border-radius: 14px;
        background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
        color: #fff;
        font-family: "Archivo Black", sans-serif;
        font-size: 1rem;
        flex-shrink: 0;
        box-shadow: 0 10px 20px rgba(var(--primary-rgb), 0.18);
    }

    .panel-heading h2 {
        margin: 0;
        font-size: 1.2rem;
    }

    .venta-form {
        width: 100%;
        margin: 0;
        padding: 0;
        background: transparent;
        border: none;
        box-shadow: none;
        backdrop-filter: none;
    }

    .producto-module {
        grid-column: 1 / -1;
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.85rem 1rem;
        padding: 1.1rem;
        border-radius: var(--radius-md);
        background: linear-gradient(180deg, rgba(236, 231, 246, 0.5), rgba(255, 255, 255, 0.72));
        border: 1px solid rgba(var(--secondary-rgb), 0.08);
    }

    .producto-module_search,
    .producto-module_select,
    .producto-module_actions {
        grid-column: 1 / -1;
    }

    .precio-referencia {
        display: block;
        margin-top: 0.35rem;
        font-size: 0.78rem;
        font-weight: 700;
        color: var(--secondary-color);
        line-height: 1.4;
    }

    .invoice-table-card {
        padding: 1.15rem;
    }

    .table-heading {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 1rem;
        margin-bottom: 1rem;
    }

    .table-heading h2 {
        margin: 0;
        font-size: 1.2rem;
    }

    .table-caption {
        font-size: 0.74rem;
        font-weight: 800;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #4f3d78;
        text-align: right;
        max-width: 28ch;
        line-height: 1.5;
    }

    .confirm-step {
        display: flex;
        justify-content: center;
    }

    .btn-confirmar {
        appearance: none;
        border: none;
        border-radius: 999px;
        padding: 0.75rem 1.4rem;
        font-size: 0.86rem;
        font-weight: 700;
        letter-spacing: 0.02em;
        background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
        color: #fff;
        box-shadow: 0 10px 24px rgba(var(--primary-rgb), 0.22);
        transition:
            transform 160ms ease,
            box-shadow 160ms ease,
            opacity 160ms ease;
    }

    .btn-confirmar:hover:not(:disabled) {
        transform: translateY(-2px);
        box-shadow: 0 14px 26px rgba(var(--primary-rgb), 0.22);
        cursor: pointer;
    }

    .btn-confirmar:disabled {
        opacity: 0.55;
        cursor: not-allowed;
    }

    .checkout-panel {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        width: 100%;
        max-width: none;
    }

    .checkout-form {
        align-items: start;
    }

    .checkout-form .select-container {
        grid-template-columns: 1fr auto;
        align-items: end;
    }

    .checkout-form .select-container label {
        grid-column: 1 / -1;
    }

    .btn-cliente {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 44px;
        width: 44px;
        border-radius: 50%;
        cursor: pointer;
        font-weight: bold;
        font-size: 1.2rem;
        color: #fff;
        background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
        box-shadow: 0 8px 18px rgba(var(--primary-rgb), 0.18);
        transition: transform 160ms ease, box-shadow 160ms ease;
        align-self: end;
    }

    .btn-cliente:hover {
        transform: translateY(-1px);
        box-shadow: 0 12px 22px rgba(var(--primary-rgb), 0.22);
    }

    .cliente-nuevo-panel {
        grid-column: 1 / -1;
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.85rem 1rem;
        padding: 1rem;
        border-radius: var(--radius-md);
        background: rgba(236, 231, 246, 0.45);
        border: 1px dashed rgba(var(--secondary-rgb), 0.18);
    }

    .cliente-nuevo_title {
        grid-column: 1 / -1;
        margin: 0 0 0.15rem;
        font-size: 0.78rem;
        font-weight: 800;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--secondary-color);
    }

    .cliente-nuevo-panel .form-actions {
        grid-column: 1 / -1;
    }

    .checkout-total {
        grid-column: 1 / -1;
        width: min(100%, 420px);
        margin-left: auto;
        padding: 1rem 1.1rem;
        border-radius: 22px;
        background: linear-gradient(135deg, #dbeafe, #bfdbfe);
        color: #0f172a;
        border: 1px solid rgba(37, 99, 235, 0.18);
        box-shadow: 0 18px 28px rgba(37, 99, 235, 0.14);
    }

    .checkout-total p {
        color: inherit;
    }

    .total-box_label {
        margin: 0 0 0.5rem;
        font-size: 0.76rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: #1d4ed8;
    }

    .total-box_amount {
        margin: 0;
        font-size: 1.35rem;
        font-weight: 800;
        line-height: 1.2;
        color: #0f172a;
    }

    .checkout-actions {
        grid-column: 1 / -1;
        justify-content: flex-end;
    }

    .pagos-venta-panel,
    .pagos-venta_credito {
        grid-column: 1 / -1;
    }

    .pagos-venta-panel {
        display: grid;
        gap: 0.85rem;
        padding: 1rem;
        border-radius: var(--radius-md);
        background: rgba(236, 231, 246, 0.45);
        border: 1px dashed rgba(var(--secondary-rgb), 0.18);
    }

    .pagos-venta-panel[hidden],
    .pagos-venta_credito[hidden],
    .pagos-venta_tabla[hidden] {
        display: none !important;
    }

    .pagos-venta_title {
        margin: 0;
        font-size: 0.78rem;
        font-weight: 800;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--secondary-color);
    }

    .pagos-venta_hint,
    .pagos-venta_credito {
        margin: 0;
        font-size: 0.85rem;
        color: var(--text-muted);
        line-height: 1.45;
    }

    .pagos-venta_form {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 0.75rem 1rem;
        align-items: end;
    }

    .pagos-venta_add {
        grid-column: 1 / -1;
        margin: 0;
    }

    .pagos-venta_tabla {
        margin: 0;
    }

    .pagos-venta_resumen {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem 1.4rem;
        font-size: 0.9rem;
    }

    .pagos-venta_resumen p {
        margin: 0;
    }

    .pagos-venta_resumen.is-completo strong {
        color: #15803d;
    }

    @media (max-width: 768px) {
        .producto-module,
        .cliente-nuevo-panel,
        .checkout-form,
        .pagos-venta_form {
            grid-template-columns: 1fr;
        }

        .table-heading {
            flex-direction: column;
        }

        .table-caption {
            text-align: left;
            max-width: none;
        }

        .checkout-total {
            width: 100%;
            margin-left: 0;
        }

        .btn-confirmar {
            width: 100%;
            min-height: 44px;
        }

        .checkout-actions {
            justify-content: stretch;
        }

        .checkout-actions button {
            width: 100%;
        }
    }

    /* Estilos de las etiquetas (tags) de los seriales seleccionados */
    :global(.serial-tag) {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        background: linear-gradient(135deg, rgba(var(--primary-rgb), 0.1), rgba(var(--primary-rgb), 0.2));
        border: 1px solid rgba(var(--primary-rgb), 0.3);
        color: var(--secondary-color);
        font-family: monospace;
        font-size: 0.9rem;
        font-weight: 600;
        padding: 0.3rem 0.6rem 0.3rem 0.85rem;
        border-radius: 99px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.02);
        animation: scaleIn 200ms ease forwards;
    }

    :global(.serial-tag-remove) {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 22px;
        height: 22px;
        border-radius: 50%;
        background: rgba(239, 68, 68, 0.15);
        color: #ef4444;
        cursor: pointer;
        font-size: 0.75rem;
        font-weight: bold;
        line-height: 1;
        transition: all 150ms ease;
        margin-left: 0.2rem;
    }
    :global(.serial-tag-remove:hover) {
        background: #ef4444;
        color: #fff;
        transform: scale(1.15);
    }

    @keyframes scaleIn {
        from { opacity: 0; transform: scale(0.95); }
        to { opacity: 1; transform: scale(1); }
    }
</style>

<script>

    import { mostrarError, mostrarMensaje } from '@/utils/helpers/mensajes.js';
    import { crearModuloSeriales } from '@/utils/helpers/seleccionSerial.js';
    
    let serialesDisponiblesMemoria: string[] = [];
    let serialesSeleccionadosMemoria: string[] = [];
    let moduloSeriales: any = null;
    import { obtenerTasas } from '@/utils/helpers/cambioMoneda.js';
    import { ponerIcono } from '@/utils/helpers/iconosAccion.js';
    import { validarCliente } from '@/utils/clienteValidaciones.js';
    import {
        convertirPrecio,
        desgloseMontos,
        formatearMoneda,
        obtenerMonedaBase,
        textoReferencia,
        textoTotal,
        toleranciaPago,
    } from '@/utils/helpers/tasas.js';
    import {
        etiquetaPago,
        metodosDeMoneda,
        montoRestanteEnMoneda,
        monedasPagoDisponibles,
        parsearLineaPago,
        resumenPagos,
        validarPagosVenta,
    } from '@/utils/helpers/metodosPago.js';
    import {
        crearModuloProductos,
        enfocarBusquedaProductos,
        reiniciarBusquedaProductos,
    } from '@/utils/helpers/seleccionProducto.js';

    const monedaBase = obtenerMonedaBase();
    let moduloProductos: ReturnType<typeof crearModuloProductos> | null = null;

    const productoSelect = document.getElementById("productoSelect") as HTMLSelectElement;
    const precioInput = document.getElementById("precio") as HTMLInputElement;
    const precioReferencia = document.getElementById("precioReferencia") as HTMLSpanElement;

    async function actualizarReferenciaPrecio() {
        const precio = parseFloat(precioInput.value.replace(',', '.'));
        const tasas = await obtenerTasas();
        precioReferencia.textContent = textoReferencia(precio, monedaBase, tasas);
    }

    async function aplicarPrecioProducto(producto: Producto) {
        const venta = parseFloat(String(producto.venta ?? ''));

        if (!Number.isNaN(venta) && venta > 0) {
            precioInput.value = monedaBase === 'COP' ? String(venta) : venta.toFixed(2);
        } else {
            precioInput.value = "";
        }

        await actualizarReferenciaPrecio();
    }

    function htmlMontosCelda(precio: number, tasas: { cop: number; bs: number }) {
        const { principal, secundarias } = desgloseMontos(precio, monedaBase, tasas);
        const referencia = secundarias
            ? `<br /><span style="font-size: 0.78rem; color: var(--text-muted);">${secundarias}</span>`
            : '';

        return `<strong>${principal}</strong>${referencia}`;
    }

    function iniciarModuloProductos() {
        if (moduloProductos) return;

        const cantidadInput = document.getElementById("cantidad") as HTMLInputElement;

        moduloProductos = crearModuloProductos({
            productoSelect,
            cantidadInput,
            onNoEncontrado: mostrarError,
        });
        
        const busquedaSeriales = document.getElementById("busquedaSeriales") as HTMLInputElement;
        const serialSelect = document.getElementById("dropdownSeriales") as HTMLSelectElement;
        moduloSeriales = crearModuloSeriales({
            serialSelect,
            busquedaInput: busquedaSeriales
        });
    }

    function iniciarPagina() {
        rellenarSelectClientes();
        iniciarModuloProductos();
    }

    interface Cliente {
        id: number;
        nombre: string;
        cedula: string;
        telefono: string;
    }

    interface Producto {
        codigo: string;
        nombre: string;
        precio: number;
        cantidad: number;
        id: number;

        stock: number;
        costo: number;
        venta: number;
        unidad_medida: string;
        serialesDisponibles?: string[];
        serialesSeleccionados?: string[];
    }

    const btnAbrirMenuClienteNuevo = document.getElementById("abrirMenuClienteNuevo") as HTMLSpanElement;
    const btnAgregarClienteNuevo = document.getElementById("btnAgregarClienteNuevo") as HTMLButtonElement;
    const selectClientes = document.getElementById("cliente") as HTMLSelectElement;
    const busquedaClientes = document.getElementById("busquedaClientes") as HTMLInputElement;
    const moduloAgregarCliente = document.getElementById("moduloAgregarClienteNuevo") as HTMLDivElement;
    const inputClienteNombre = document.getElementById("clienteNuevoNombre") as HTMLInputElement;
    const inputClienteCedula = document.getElementById("clienteNuevoCedula") as HTMLInputElement;
    const inputClienteTelefono = document.getElementById("clienteNuevoTelefono") as HTMLInputElement;

    let clientesListados: Cliente[] = [];
    let clienteDeLaVenta: Cliente | null = null;
    let cargaClientesSeq = 0;
    let busquedaClientesTimer: ReturnType<typeof setTimeout> | null = null;
    let registrandoCliente = false;

    function idCliente(valor: unknown) {
        if (!valor) return '';
        return String(valor).trim();
    }

    function textoOpcionCliente(cliente: Cliente) {
        return `${String(cliente.nombre || "").toUpperCase()} - ${cliente.cedula}`;
    }

    function clientesParaSelect(clientes: Cliente[]) {
        if (!clienteDeLaVenta) return clientes;
        const id = idCliente(clienteDeLaVenta.id);
        return [clienteDeLaVenta, ...clientes.filter(cliente => idCliente(cliente.id) !== id)];
    }

    function renderOpcionesClientes(clientes: Cliente[]) {
        const lista = clientesParaSelect(clientes);
        const seleccionado = idCliente(clienteDeLaVenta?.id) || idCliente(selectClientes.value);
        selectClientes.innerHTML = "";

        const defaultOption = document.createElement("option");
        defaultOption.value = "";
        defaultOption.textContent = "Selecciona un cliente";
        defaultOption.disabled = true;
        selectClientes.appendChild(defaultOption);

        if (lista.length === 0) {
            const noResultsOption = document.createElement("option");
            noResultsOption.value = "";
            noResultsOption.textContent = "— Sin coincidencias para la búsqueda —";
            noResultsOption.disabled = true;
            selectClientes.appendChild(noResultsOption);
            defaultOption.selected = true;
            return;
        }

        lista.forEach(cliente => {
            const option = document.createElement("option");
            option.value = idCliente(cliente.id);
            option.textContent = textoOpcionCliente(cliente);
            selectClientes.appendChild(option);
        });

        if (seleccionado && lista.some(cliente => idCliente(cliente.id) === seleccionado)) {
            selectClientes.value = seleccionado;
            return;
        }

        defaultOption.selected = true;
    }

    async function cargarClientes(filtro = "") {
        const seq = ++cargaClientesSeq;
        const params = new URLSearchParams({ limit: filtro ? "80" : "500" });
        if (filtro) params.set("search", filtro);

        try {
            const response = await fetch(`/api/clientes?${params.toString()}`);
            const data = await response.json();
            if (seq !== cargaClientesSeq) return;
            clientesListados = Array.isArray(data) ? data : [];
            renderOpcionesClientes(clientesListados);
        } catch (error) {
            if (seq !== cargaClientesSeq) return;
            console.error("Error al cargar los clientes:", error);
            mostrarError("No se pudieron cargar los clientes");
        }
    }

    function seleccionarClienteEnVenta(cliente: Cliente) {
        if (busquedaClientesTimer) {
            clearTimeout(busquedaClientesTimer);
            busquedaClientesTimer = null;
        }

        clienteDeLaVenta = {
            id: cliente.id,
            nombre: cliente.nombre,
            cedula: cliente.cedula,
            telefono: cliente.telefono,
        };

        const id = idCliente(clienteDeLaVenta.id);
        const yaListado = clientesListados.some(item => idCliente(item.id) === id);
        if (!yaListado) {
            clientesListados = [clienteDeLaVenta, ...clientesListados];
        } else {
            clientesListados = clientesListados.map(item => idCliente(item.id) === id ? clienteDeLaVenta as Cliente : item);
        }

        busquedaClientes.value = "";
        cargaClientesSeq += 1;
        renderOpcionesClientes(clientesListados);
        selectClientes.value = id;
        selectClientes.dispatchEvent(new Event('change'));
    }

    function cerrarPanelClienteNuevo() {
        moduloAgregarCliente.style.display = "none";
        btnAbrirMenuClienteNuevo.textContent = "+";
        inputClienteNombre.value = "";
        inputClienteCedula.value = "";
        inputClienteTelefono.value = "";
    }

    async function rellenarSelectClientes() {
        await cargarClientes(busquedaClientes.value.trim());
    }

    productoSelect.addEventListener("change", async () => {
        const productoId = productoSelect.value;
        const panelSeriales = document.getElementById("panelSerialesVenta") as HTMLDivElement;
        const listaSeriales = document.getElementById("listaSerialesVenta") as HTMLDivElement;
        const cantidadInput = document.getElementById("cantidad") as HTMLInputElement;

        if (!productoId) {
            precioInput.value = "";
            panelSeriales.style.display = "none";
            listaSeriales.innerHTML = "";
            cantidadInput.readOnly = false;
            cantidadInput.value = "";
            await actualizarReferenciaPrecio();
            return;
        }

        try {
            const response = await fetch(`/api/productos/${productoId}`);

            if (!response.ok) {
                console.error("Error al obtener el producto:", response.status);
                precioInput.value = "";
                panelSeriales.style.display = "none";
                listaSeriales.innerHTML = "";
                cantidadInput.readOnly = false;
                await actualizarReferenciaPrecio();
                return;
            }

            const producto = await response.json();
            aplicarPrecioProducto(producto);

            if (producto.serialesDisponibles && producto.serialesDisponibles.length > 0) {
                panelSeriales.style.display = "grid";
                serialesDisponiblesMemoria = [...producto.serialesDisponibles];
                serialesSeleccionadosMemoria = [];
                listaSeriales.innerHTML = "";
                moduloSeriales.cargarSeriales(serialesDisponiblesMemoria);
                cantidadInput.readOnly = true;
                cantidadInput.value = "0";
            } else {
                panelSeriales.style.display = "none";
                const ls = document.getElementById("dropdownSeriales");
                if (ls) ls.innerHTML = "";
                cantidadInput.readOnly = false;
                cantidadInput.value = "";
                serialesDisponiblesMemoria = [];
                serialesSeleccionadosMemoria = [];
                if (moduloSeriales) {
                    moduloSeriales.cargarSeriales([]);
                }
            }
        } catch (error) {
            console.error("Error de red o parsing:", error);
            precioInput.value = "";
            panelSeriales.style.display = "none";
            listaSeriales.innerHTML = "";
            cantidadInput.readOnly = false;
            await actualizarReferenciaPrecio();
        }
    });

    precioInput.addEventListener("input", () => {
        actualizarReferenciaPrecio();
    });

    const btnagregarProducto = document.getElementById("agregarProducto") as HTMLButtonElement;
    let productosSeleccionados : Producto[] = [];

    btnagregarProducto.addEventListener("click", async (e : Event) => {
            
        e.preventDefault();

        const productoId = productoSelect.value;
        const cantidadInput = document.getElementById("cantidad") as HTMLInputElement;
        const cantidad = parseFloat(cantidadInput.value.replace(",", "."));
        const precio = parseFloat(precioInput.value.replace(",", "."));


        try {
            const response = await fetch(`/api/productos/${productoId}`);
            if (!response.ok) {
                throw new Error('Error al obtener el producto: ' + response.status);
            }
            const producto = await response.json();

            if (!producto || !producto.stock) {
                mostrarError('Producto no encontrado o sin stock disponible');
                return;
            }

            let serialesSeleccionados: string[] = [];
            if (producto.serialesDisponibles && producto.serialesDisponibles.length > 0) {
                serialesSeleccionados = [...serialesSeleccionadosMemoria];
                
                if (serialesSeleccionados.length === 0) {
                    mostrarError("Debe seleccionar al menos un serial para vender este producto.");
                    return;
                }
                if (serialesSeleccionados.length !== cantidad) {
                    mostrarError("La cantidad no coincide con los seriales seleccionados.");
                    return;
                }
            }

            if (isNaN(cantidad) || Number(cantidad) <= 0) {
                mostrarError("Ingresa una cantidad válida mayor a cero");
                return;
            }

            if (isNaN(precio) || Number(precio) <= 0) {
                mostrarError("El precio del producto no es válido");
                return;
            }

            if (Number(cantidad) > producto.stock) {
                mostrarError(`Cantidad insuficiente en stock. Stock disponible: ${producto.stock}`);
                return;
            }

            const tasas = await obtenerTasas();
            const claveBase = monedaBase.toLowerCase() as 'usd' | 'cop';
            const precioUnitario = convertirPrecio(precio, monedaBase, tasas)[claveBase];
            const subtotal = precioUnitario * cantidad;

            const theader = document.getElementById("headerTablaProductos") as HTMLTableSectionElement;

            const btnConfirmacion = document.getElementById("btnConfirmacion") as HTMLButtonElement;

            const tablaProductos = document.getElementById("listaProductos") as HTMLTableSectionElement;
            const fila = document.createElement("tr");
            fila.innerHTML = `
                                <td data-label="Producto">
                                    <strong>${producto.nombre.toUpperCase()}</strong>
                                    <br />
                                    <span style="font-size: 0.78rem; color: var(--text-muted);">${producto.codigo}</span>
                                </td>
                                <td data-label="P. Unitario">
                                    ${htmlMontosCelda(precioUnitario, tasas)}
                                </td>
                                <td data-label="Cantidad">${cantidad} U.</td>
                                <td data-label="Subtotal">
                                    ${htmlMontosCelda(subtotal, tasas)}
                                </td>
                            `;

            const tdAcciones = document.createElement('td');
            tdAcciones.classList.add('acciones');

            const btnEliminar = document.createElement('button');
            btnEliminar.type = 'button';
            btnEliminar.classList.add('btn-eliminar');
            ponerIcono(btnEliminar, 'eliminar');
            btnEliminar.addEventListener('click', () => {

                fila.remove();

                productosSeleccionados = productosSeleccionados.filter(p => p.codigo !== producto.codigo);
                
                if(tablaProductos.innerHTML.trim() === "") {
                    theader.style.opacity = "0";
                    btnConfirmacion.style.display = "none";
                    btnConfirmacion.disabled = true;
                } else {
                    theader.style.opacity = "1";
                    btnConfirmacion.style.display = "inline-block";
                    btnConfirmacion.disabled = false;
                }
            });

            tdAcciones.appendChild(btnEliminar);
            fila.appendChild(tdAcciones);
            tablaProductos.appendChild(fila);

            if(tablaProductos.innerHTML.trim() === "") {
                theader.style.opacity = "0";
                btnConfirmacion.style.display = "none";
                btnConfirmacion.disabled = true;
            } else {
                theader.style.opacity = "1";
                btnConfirmacion.style.display = "inline-block";
                btnConfirmacion.disabled = false;
            }

            productoSelect.value = "";
            cantidadInput.value = "";
            precioInput.value = "";
            await actualizarReferenciaPrecio();
            reiniciarBusquedaProductos();
            enfocarBusquedaProductos();

            productosSeleccionados.push({
                id: producto.id,
                nombre: producto.nombre,
                codigo: producto.codigo,
                precio: precioUnitario,
                cantidad: cantidad,
                stock: producto.stock,
                costo: producto.costo,
                venta: producto.venta,
                unidad_medida: producto.unidad_medida,
                serialesSeleccionados: serialesSeleccionados
            });

        } catch (error) {
            console.error("Error al obtener el producto:", error);
            return;
        }
    });

    const btnConfirmacion = document.getElementById("btnConfirmacion") as HTMLButtonElement;

    let totalDeVenta = 0;
    let tasasVenta = { cop: 0, bs: 0 };
    let pagosVenta: { moneda: string; metodo: string; monto: number; monto_base: number }[] = [];

    const tipoPagoSelect = document.getElementById("tipoPago") as HTMLSelectElement;
    const moduloPagosVenta = document.getElementById("moduloPagosVenta") as HTMLDivElement;
    const avisoPagoCredito = document.getElementById("avisoPagoCredito") as HTMLParagraphElement;
    const pagoMonedaSelect = document.getElementById("pagoMoneda") as HTMLSelectElement;
    const pagoMetodoSelect = document.getElementById("pagoMetodo") as HTMLSelectElement;
    const pagoMontoInput = document.getElementById("pagoMonto") as HTMLInputElement;
    const listaPagosVenta = document.getElementById("listaPagosVenta") as HTMLTableSectionElement;
    const pagosVentaTablaWrap = document.getElementById("pagosVentaTablaWrap") as HTMLDivElement;
    const pagosCubierto = document.getElementById("pagosCubierto") as HTMLElement;
    const pagosFalta = document.getElementById("pagosFalta") as HTMLElement;
    const pagosVentaResumen = document.getElementById("pagosVentaResumen") as HTMLDivElement;

    function rellenarMetodosPago() {
        const moneda = pagoMonedaSelect.value;
        const metodos = metodosDeMoneda(moneda);
        const actual = pagoMetodoSelect.value;
        pagoMetodoSelect.innerHTML = metodos.map((metodo: { id: string; etiqueta: string }) => (
            `<option value="${metodo.id}">${metodo.etiqueta}</option>`
        )).join('');
        if (metodos.some((metodo: { id: string }) => metodo.id === actual)) {
            pagoMetodoSelect.value = actual;
        }
    }

    function rellenarMonedasPago() {
        const monedas = monedasPagoDisponibles(tasasVenta);
        const actual = pagoMonedaSelect.value;
        pagoMonedaSelect.innerHTML = monedas.map((moneda: { id: string; etiqueta: string }) => (
            `<option value="${moneda.id}">${moneda.etiqueta}</option>`
        )).join('');
        if (monedas.some((moneda: { id: string }) => moneda.id === actual)) {
            pagoMonedaSelect.value = actual;
        } else if (monedas[0]) {
            pagoMonedaSelect.value = monedas[0].id;
        }
        rellenarMetodosPago();
        sugerirMontoRestante();
    }

    function resumenActualPagos() {
        return resumenPagos(pagosVenta, totalDeVenta, monedaBase, tasasVenta);
    }

    function sugerirMontoRestante() {
        const { restante, completo } = resumenActualPagos();
        if (completo || restante <= 0) {
            pagoMontoInput.value = '';
            pagoMontoInput.placeholder = '0';
            return;
        }

        const moneda = pagoMonedaSelect.value;
        const sugerido = montoRestanteEnMoneda(restante, moneda, monedaBase, tasasVenta);
        pagoMontoInput.placeholder = moneda === 'COP'
            ? String(Math.round(sugerido) || 0)
            : (sugerido || 0).toFixed(2);
    }

    function renderPagosVenta() {
        const resumen = resumenActualPagos();
        pagosCubierto.textContent = resumen.cubiertoTexto;
        pagosFalta.textContent = resumen.completo ? '0' : resumen.restanteTexto;
        pagosVentaResumen.classList.toggle('is-completo', resumen.completo);
        pagosVentaTablaWrap.hidden = pagosVenta.length === 0;
        listaPagosVenta.innerHTML = '';

        pagosVenta.forEach((pago, indice) => {
            const fila = document.createElement('tr');
            fila.innerHTML = `
                <td data-label="Método">${etiquetaPago(pago.moneda, pago.metodo)}</td>
                <td data-label="Recibido">${formatearMoneda(pago.monto, pago.moneda)}</td>
                <td data-label="Equivalente">${formatearMoneda(pago.monto_base, monedaBase)}</td>
                <td class="acciones"></td>
            `;
            const btnEliminar = document.createElement('button');
            btnEliminar.type = 'button';
            btnEliminar.classList.add('btn-eliminar');
            ponerIcono(btnEliminar, 'eliminar');
            btnEliminar.addEventListener('click', () => {
                pagosVenta.splice(indice, 1);
                renderPagosVenta();
            });
            fila.querySelector('.acciones')?.appendChild(btnEliminar);
            listaPagosVenta.appendChild(fila);
        });

        sugerirMontoRestante();
    }

    function mostrarPanelPagos() {
        const tipo = tipoPagoSelect.value;
        moduloPagosVenta.hidden = tipo !== 'contado';
        avisoPagoCredito.hidden = tipo !== 'credito';
        if (tipo === 'contado') {
            rellenarMonedasPago();
            renderPagosVenta();
        }
    }

    function agregarPagoVenta() {
        const linea = parsearLineaPago({
            moneda: pagoMonedaSelect.value,
            metodo: pagoMetodoSelect.value,
            monto: pagoMontoInput.value,
        }, monedaBase, tasasVenta);

        if (!linea.ok) {
            mostrarError(linea.error);
            return;
        }

        const pagoNuevo = linea.pago;
        const cubierto = pagosVenta.reduce((acc, pago) => acc + pago.monto_base, 0) + pagoNuevo.monto_base;
        const exceso = cubierto - totalDeVenta;
        if (exceso > toleranciaPago(monedaBase)) {
            mostrarError(`Los pagos exceden el total por ${formatearMoneda(exceso, monedaBase)}`);
            return;
        }

        pagosVenta.push({
            moneda: pagoNuevo.moneda,
            metodo: pagoNuevo.metodo,
            monto: pagoNuevo.monto,
            monto_base: pagoNuevo.monto_base,
        });
        pagoMontoInput.value = '';
        renderPagosVenta();
    }

    tipoPagoSelect.addEventListener('change', mostrarPanelPagos);
    pagoMonedaSelect.addEventListener('change', () => {
        rellenarMetodosPago();
        sugerirMontoRestante();
    });
    document.getElementById('btnAgregarPago')?.addEventListener('click', agregarPagoVenta);
    pagoMontoInput.addEventListener('keydown', (event) => {
        if (event.key === 'Enter') {
            event.preventDefault();
            agregarPagoVenta();
        }
    });

    btnConfirmacion.addEventListener("click", async () => {
        
        const moduloDatosCompletar = document.getElementById("moduloDatosCompletar") as HTMLDivElement;
        moduloDatosCompletar.style.display = "flex";

        btnConfirmacion.disabled = true;
        btnConfirmacion.textContent = "Procesando...";

        const tasas = await obtenerTasas();
        tasasVenta = tasas;
        pagosVenta = [];
        const total = productosSeleccionados.map(p => p.precio * p.cantidad).reduce((a, b) => a + b, 0);
        const totalTexto = document.getElementById("totalDeVenta") as HTMLParagraphElement;
        totalTexto.textContent = textoTotal(total, monedaBase, tasas);
        totalDeVenta = total;
        mostrarPanelPagos();

        moduloDatosCompletar.scrollIntoView({ behavior: 'smooth', block: 'start' });

    });

    const infoCreditoCliente = document.getElementById("infoCreditoCliente") as HTMLDivElement;
    const montoCreditoCliente = document.getElementById("montoCreditoCliente") as HTMLElement;

    selectClientes.addEventListener("change", async () => {
        const id = idCliente(selectClientes.value);
        if (!id) {
            infoCreditoCliente.style.display = "none";
            return;
        }

        const encontrado = clientesParaSelect(clientesListados).find(cliente => idCliente(cliente.id) === id) || null;
        clienteDeLaVenta = encontrado;

        // Buscar si tiene notas de crédito
        try {
            const res = await fetch(`/api/devoluciones/notasCredito?cliente_id=${id}`);
            if (res.ok) {
                const data = await res.json();
                if (data.saldo_total > 0) {
                    montoCreditoCliente.textContent = `${data.saldo_total.toFixed(2)} USD`;
                    infoCreditoCliente.style.display = "block";
                } else {
                    infoCreditoCliente.style.display = "none";
                }
            }
        } catch (e) {
            console.error("Error buscando notas de crédito", e);
            infoCreditoCliente.style.display = "none";
        }
    });

    busquedaClientes.addEventListener("input", () => {
        if (busquedaClientesTimer) clearTimeout(busquedaClientesTimer);
        busquedaClientesTimer = setTimeout(() => {
            cargarClientes(busquedaClientes.value.trim());
        }, 250);
    });

    btnAbrirMenuClienteNuevo.addEventListener("click", (e) => {
        e.preventDefault();
        const abierto = moduloAgregarCliente.style.display === "grid";
        moduloAgregarCliente.style.display = abierto ? "none" : "grid";
        btnAbrirMenuClienteNuevo.textContent = abierto ? "+" : "−";
        if (!abierto) {
            inputClienteNombre.focus();
        }
    });

    btnAgregarClienteNuevo.addEventListener("click", agregarClienteNuevo);

    moduloAgregarCliente.addEventListener("keydown", (e) => {
        if (e.key === "Enter") {
            e.preventDefault();
            agregarClienteNuevo(e);
        }
    });

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', iniciarPagina);
    } else {
        iniciarPagina();
    }

    async function agregarClienteNuevo(event : Event) {

        event.preventDefault();

        if (registrandoCliente) return;

        const validado = validarCliente({
            nombre: inputClienteNombre.value,
            telefono: inputClienteTelefono.value,
            cedula: inputClienteCedula.value,
        });

        if (!validado.ok) {
            mostrarError(validado.error);
            return;
        }

        registrandoCliente = true;
        btnAgregarClienteNuevo.disabled = true;
        const textoBoton = btnAgregarClienteNuevo.textContent;
        btnAgregarClienteNuevo.textContent = "Registrando...";

        try {
            const response = await fetch("/api/clientes", {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(validado.cliente)
            });

            const raw = await response.text();
            let data: any = null;
            try {
                data = raw ? JSON.parse(raw) : null;
            } catch {}

            if (!response.ok) {
                mostrarError(data?.error || data?.message || raw || `Error al agregar cliente: ${response.status}`);
                return;
            }

            const clienteAgregado = Array.isArray(data?.cliente) ? data.cliente[0] : data?.cliente;
            if (!clienteAgregado?.id) {
                mostrarError("El cliente se guardó, pero no se pudo seleccionar. Recarga e inténtalo de nuevo.");
                return;
            }

            seleccionarClienteEnVenta(clienteAgregado);
            cerrarPanelClienteNuevo();
            mostrarMensaje(data?.message || "Cliente agregado exitosamente.");
        } catch (error) {
            console.error("Error al agregar cliente:", error);
            mostrarError("Error al agregar el cliente. Inténtalo de nuevo.");
        } finally {
            registrandoCliente = false;
            btnAgregarClienteNuevo.disabled = false;
            btnAgregarClienteNuevo.textContent = textoBoton || "Registrar cliente";
        }
    }

    const btnFinalizar = document.getElementById("btnFinalizar") as HTMLButtonElement;

    btnFinalizar.addEventListener("click", async e => {

        e.preventDefault();

        const fecha = (document.getElementById('fecha') as HTMLInputElement).value;
        const tipoPago = (document.getElementById('tipoPago') as HTMLSelectElement).value;
        const clienteId = idCliente(clienteDeLaVenta?.id) || idCliente(selectClientes.value);

        if (!fecha || !tipoPago || !clienteId) {
            mostrarError("Todos los campos son obligatorios");
            return;
        }

        if (productosSeleccionados.length === 0) {
            mostrarError("No hay productos seleccionados para la venta");
            return;
        }

        if (isNaN(totalDeVenta) || totalDeVenta <= 0) {
            mostrarError("El total de la venta no es válido");
            return;
        }

        const pagosValidados = validarPagosVenta({
            tipoPago,
            pagos: pagosVenta,
            totalBase: totalDeVenta,
            monedaBase,
            tasas: tasasVenta,
        });

        if (!pagosValidados.ok) {
            mostrarError(pagosValidados.error);
            return;
        }

        try  {

            const response = await fetch("/api/ventas/completa", {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    fecha,
                    tipoPago,
                    clienteId,
                    totalDeVenta,
                    pagos: pagosValidados.pagos,
                    productos: productosSeleccionados.map(({ codigo, nombre, precio, cantidad, id, serialesSeleccionados }) => ({
                        idProducto: id,
                        codigo,
                        nombre,
                        precio,
                        cantidad,
                        seriales: serialesSeleccionados
                    }))
                })
            });

            const data = await response.json();

            if (!response.ok) {
                mostrarError(data.error || 'Error al crear la venta');
                return;
            }

            mostrarMensaje('¡Venta finalizada correctamente!');

            setTimeout(() => {
                window.location.href = `/ventas/${data.ventaId}`;
            }, 1750);

        } catch (error) {
            console.error("Error al crear la venta:", error);
            mostrarError("Error al crear la venta. Por favor, inténtalo de nuevo.");
            return;
        }
    });

    // --- Lógica del Buscador/Multiselect de Seriales ---
    const selectSeriales = document.getElementById("dropdownSeriales") as HTMLSelectElement;
    const listaSerialesVenta = document.getElementById("listaSerialesVenta") as HTMLDivElement;

    selectSeriales?.addEventListener("change", () => {
        const serial = selectSeriales.value;
        if (serial && !serialesSeleccionadosMemoria.includes(serial)) {
            serialesSeleccionadosMemoria.push(serial);
            renderizarTagsSeriales();
            actualizarOpcionesSeriales();
            
            // Hacer reset visual en el trigger
            if (moduloSeriales) {
                moduloSeriales.reset();
            }
        }
    });

    function actualizarOpcionesSeriales() {
        if (!moduloSeriales) return;
        const disponibles = serialesDisponiblesMemoria.filter(s => !serialesSeleccionadosMemoria.includes(s));
        moduloSeriales.cargarSeriales(disponibles);
    }

    function renderizarTagsSeriales() {
        if (!listaSerialesVenta) return;
        
        listaSerialesVenta.innerHTML = serialesSeleccionadosMemoria.map(s => 
            `<div class="serial-tag">
                ${s}
                <div class="serial-tag-remove" data-serial="${s}" title="Remover serial">✕</div>
            </div>`
        ).join('');

        // Actualizar la cantidad visual
        const cantidadInput = document.getElementById("cantidad") as HTMLInputElement;
        if (cantidadInput && cantidadInput.readOnly) {
            cantidadInput.value = serialesSeleccionadosMemoria.length.toString();
        }

        // Agregar eventos de eliminar
        listaSerialesVenta.querySelectorAll(".serial-tag-remove").forEach(btn => {
            btn.addEventListener("click", (e) => {
                const s = (e.target as HTMLElement).getAttribute("data-serial");
                if (s) {
                    serialesSeleccionadosMemoria = serialesSeleccionadosMemoria.filter(item => item !== s);
                    renderizarTagsSeriales();
                    actualizarOpcionesSeriales();
                }
            });
        });
    }

</script>
