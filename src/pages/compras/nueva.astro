---
import Layout from "../../layouts/Layout.astro";
import { verificarToken } from "@/utils/auth.js";

const usuario = verificarToken(Astro.request);
if (!usuario) {
    return Astro.redirect("/login");
}
if (usuario.rol !== "admin") {
    return Astro.redirect("/dashboard");
}
---

<Layout>
    <header class="page-header">
        <p class="eyebrow">Gestión de inventario</p>
        <h1>Registrar nueva compra</h1>
        <p class="page-intro">
            Agrega los productos de la factura y completa los datos del
            proveedor.
        </p>
    </header>

    <div class="btn-add_container">
        <a class="btn-add" href="/compras">Regresar</a>
    </div>

    <main class="venta-flow">
        <section class="venta-panel">
            <div class="panel-heading">
                <span class="step-badge">1</span>
                <div>
                    <p class="eyebrow">Factura</p>
                    <h2>Datos de la compra</h2>
                </div>
            </div>
            <section class="form-container page-form venta-form">
                <form id="formCompra" onsubmit="return false;">
                    <div class="form-field">
                        <label for="fecha">Fecha</label>
                        <input type="date" id="fecha" required />
                    </div>
                    <div class="form-field">
                        <label for="proveedor">Proveedor</label>
                        <input
                            type="text"
                            id="proveedor"
                            required
                            placeholder="Nombre del proveedor"
                        />
                    </div>
                    <div class="form-field">
                        <label for="montoTotal">Monto Total (USD)</label>
                        <input
                            type="text"
                            id="montoTotal"
                            required
                            placeholder="0.00"
                        />
                    </div>
                </form>
            </section>
        </section>

        <section class="venta-panel">
            <div class="panel-heading">
                <span class="step-badge">2</span>
                <div>
                    <p class="eyebrow">Productos</p>
                    <h2>Agregar al carrito</h2>
                </div>
            </div>
            <section class="form-container page-form venta-form">
                <div id="productos-container" class="producto-module">
                    <div class="form-field producto-module_search">
                        <label
                            for="busquedaProductos"
                            style="display: flex; justify-content: space-between; align-items: center;"
                        >
                            <span>Buscar producto</span>
                            <button
                                type="button"
                                id="btnNuevoProd"
                                style="background: none; border: none; color: var(--primary-color); font-weight: 600; cursor: pointer; padding: 0;"
                                >+ Nuevo producto</button
                            >
                        </label>
                        <input
                            type="text"
                            id="busquedaProductos"
                            placeholder="Filtrar por código o nombre..."
                            autocomplete="off"
                        />
                    </div>
                    <div class="form-field producto-module_select">
                        <label for="productoSelect">Producto seleccionado</label
                        >
                        <select name="producto" id="productoSelect"></select>
                    </div>
                </div>

                <div
                    id="panelProducto"
                    style="display: none; background: rgba(var(--primary-rgb), 0.05); padding: 1.5rem; border-radius: 12px; margin-top: 1rem; border: 1px solid rgba(var(--primary-rgb), 0.1);"
                >
                    <input type="hidden" id="prodId" />

                    <div
                        style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.85rem 1rem;"
                    >
                        <div class="form-field">
                            <label for="prodCodigo">Código *</label>
                            <input type="text" id="prodCodigo" required />
                        </div>
                        <div class="form-field">
                            <label for="prodNombre">Nombre *</label>
                            <input type="text" id="prodNombre" required />
                        </div>
                        <div class="form-field">
                            <label for="prodCantidad">Cantidad *</label>
                            <input
                                type="number"
                                step="1"
                                id="prodCantidad"
                                required
                                min="1"
                                value="1"
                            />
                        </div>
                        <div class="form-field">
                            <label for="prodCosto">Costo Unitario (USD) *</label
                            >
                            <input
                                type="number"
                                step="0.01"
                                id="prodCosto"
                                required
                                min="0"
                                value="0.00"
                            />
                        </div>
                        <div
                            class="form-field"
                            id="groupVenta"
                            style="display: none;"
                        >
                            <label for="prodVenta">Precio Venta (USD)</label>
                            <input
                                type="number"
                                step="0.01"
                                id="prodVenta"
                                min="0"
                                value="0.00"
                            />
                        </div>

                        <div
                            class="form-field checkbox-container"
                            style="grid-column: 1 / -1; margin-top: 0.5rem;"
                        >
                            <label
                                style="display:flex; align-items:center; gap:0.5rem; cursor:pointer;"
                            >
                                <input
                                    type="checkbox"
                                    id="chkSeriales"
                                    style="width: auto;"
                                />
                                Llevar control de seriales para este producto
                            </label>
                        </div>

                        <div
                            id="panelSeriales"
                            style="grid-column: 1 / -1; display:none;"
                        >
                            <p
                                class="text-sm text-muted"
                                style="margin-bottom: 0.5rem;"
                            >
                                Ingrese los seriales correspondientes a la
                                cantidad especificada.
                            </p>
                            <div
                                id="inputsSeriales"
                                class="inputs-seriales-grid"
                            >
                            </div>
                        </div>

                        <div
                            class="form-actions"
                            style="grid-column: 1 / -1; margin-top: 0.5rem;"
                        >
                            <button
                                type="button"
                                id="btnAgregarLista"
                                class="btn-confirmar"
                                style="width: 100%;">Agregar a la Compra</button
                            >
                        </div>
                    </div>
                </div>
            </section>
        </section>

        <section id="seccionTablaCompras" class="venta-panel invoice-table-card" style="display: none;">
            <div
                class="table-heading"
                style="padding-bottom: 0; margin-bottom: 1rem; display: block;"
            >
                <h2 style="margin: 0;">Productos en la compra</h2>
            </div>

            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Código</th>
                            <th>Producto</th>
                            <th>Costo</th>
                            <th>Cant.</th>
                            <th>Subtotal</th>
                            <th>Seriales</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody id="tbDetalles"> </tbody>
                </table>
            </div>

            <div style="margin-top: 2rem; display: flex; flex-direction: column; align-items: flex-start;">
                <h3 style="margin: 0 0 0.6rem 0; font-size: 0.9rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 1px; font-weight: bold;">Total de la Compra</h3>
                <div
                    id="lblTotalCalculado"
                    data-valor="0"
                    style="background: linear-gradient(135deg, rgba(var(--primary-rgb), 0.12), rgba(var(--secondary-rgb), 0.12)); padding: 1.25rem 2rem; border-radius: 16px; border: 1px solid rgba(var(--primary-rgb), 0.25); display: inline-flex; flex-direction: column; align-items: flex-start; min-width: 240px; box-shadow: 0 8px 24px rgba(var(--primary-rgb), 0.08);"
                >
                    <strong style="font-size: 1.75rem; color: var(--primary-color); line-height: 1;">$0.00 USD</strong>
                    <span style="font-size: 1.05rem; color: var(--text-muted); font-weight: 500; margin-top: 0.5rem;">0.00 Bs</span>
                </div>
            </div>

            <div
                id="errorTotal"
                style="display:none; align-items:center; justify-content:flex-start; gap:0.5rem; margin-top:1.5rem; padding: 1rem 1.25rem; background: rgba(239, 68, 68, 0.05); border: 1px solid rgba(239, 68, 68, 0.2); border-radius: 12px; color: rgb(239, 68, 68); font-weight: 500; font-size: 0.95rem;"
            >
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
                <span><strong>¡Atención!</strong> El monto total facturado no coincide con la suma calculada.</span>
            </div>
        </section>

        <div id="seccionConfirmar" class="confirm-step" style="display: none;">
            <button
                id="btnGuardarCompra"
                class="btn-confirmar"
                style="width: 100%;">Guardar Compra</button
            >
        </div>
    </main>
</Layout>

<style>
    .venta-flow {
        display: flex;
        flex-direction: column;
        gap: 1.2rem;
    }
    .venta-panel,
    .invoice-table-card {
        border-radius: 22px;
        background: rgba(255, 255, 255, 0.82);
        border: 1px solid rgba(var(--secondary-rgb), 0.08);
        box-shadow: 0 18px 32px rgba(var(--primary-rgb), 0.08);
        padding: 1.15rem;
    }
    .panel-heading {
        display: flex;
        align-items: center;
        gap: 0.9rem;
        margin-bottom: 1rem;
    }
    .step-badge {
        display: grid;
        place-items: center;
        width: 42px;
        height: 42px;
        border-radius: 14px;
        background: linear-gradient(
            135deg,
            var(--primary-color),
            var(--secondary-color)
        );
        color: #fff;
        font-family: "Archivo Black", sans-serif;
        font-size: 1rem;
        flex-shrink: 0;
        box-shadow: 0 10px 20px rgba(var(--primary-rgb), 0.18);
    }
    .panel-heading h2 {
        margin: 0;
        font-size: 1.2rem;
    }
    .panel-heading .eyebrow {
        margin: 0 0 0.15rem;
        font-size: 0.78rem;
        font-weight: 800;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--secondary-color);
    }
    .venta-form {
        width: 100%;
        margin: 0;
        padding: 0;
        background: transparent;
        border: none;
        box-shadow: none;
        backdrop-filter: none;
    }
    .producto-module {
        grid-column: 1 / -1;
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.85rem 1rem;
        padding: 1.1rem;
        border-radius: var(--radius-md);
        background: linear-gradient(
            180deg,
            rgba(236, 231, 246, 0.5),
            rgba(255, 255, 255, 0.72)
        );
        border: 1px solid rgba(var(--secondary-rgb), 0.08);
    }
    .producto-module_search,
    .producto-module_select {
        grid-column: 1 / -1;
    }
    @media (max-width: 768px) {
        .producto-module {
            grid-template-columns: 1fr;
        }
    }
    .btn-confirmar {
        appearance: none;
        border: none;
        border-radius: 999px;
        padding: 0.75rem 1.4rem;
        font-size: 0.86rem;
        font-weight: 700;
        letter-spacing: 0.02em;
        background: linear-gradient(
            135deg,
            var(--primary-color),
            var(--secondary-color)
        );
        color: #fff;
        box-shadow: 0 10px 24px rgba(var(--primary-rgb), 0.22);
        transition:
            transform 160ms ease,
            box-shadow 160ms ease,
            opacity 160ms ease;
    }
    .btn-confirmar:hover:not(:disabled) {
        transform: translateY(-2px);
        box-shadow: 0 14px 26px rgba(var(--primary-rgb), 0.22);
        cursor: pointer;
    }
    .btn-confirmar:disabled {
        opacity: 0.55;
        cursor: not-allowed;
    }

    .inputs-seriales-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
        gap: 0.5rem;
    }
    .text-sm {
        font-size: 0.85rem;
    }
    .text-muted {
        color: #666;
    }
    .text-error {
        color: #dc3545;
        font-weight: bold;
    }
    .btn-danger {
        background-color: transparent;
        color: #dc3545;
        border: 1px solid #dc3545;
        border-radius: 4px;
        padding: 0.25rem 0.5rem;
        cursor: pointer;
        font-weight: bold;
    }
    .btn-danger:hover {
        background-color: #dc3545;
        color: white;
    }
    .in-serial {
        padding: 0.6rem;
        border: 1px solid #ccc;
        border-radius: 6px;
        font-size: 1rem;
        width: 100%;
    }
</style>

<script>
    import {
        crearModuloProductos,
        reiniciarBusquedaProductos,
    } from "@/utils/helpers/seleccionProducto.js";
    import { mostrarMensaje, mostrarError } from "@/utils/helpers/mensajes.js";
    import { obtenerTasas } from "@/utils/helpers/cambioMoneda.js";
    import { desgloseMontos, obtenerMonedaBase } from "@/utils/helpers/tasas.js";

    interface ItemCarrito {
        id: string | number | null;
        codigo: string;
        nombre: string;
        cantidad: number;
        costo: number;
        venta?: number;
        seriales?: string[];
    }

    const init = () => {
        // Init Date
        const today = new Date().toISOString().split("T")[0];
        (document.getElementById("fecha") as HTMLInputElement).value = today;

        let carrito: ItemCarrito[] = [];
        let modoNuevo = false;

        // DOM Elements
        const busquedaProductos = document.getElementById(
            "busquedaProductos",
        ) as HTMLInputElement;
        const productoSelect = document.getElementById(
            "productoSelect",
        ) as HTMLSelectElement;
        const btnNuevoProd = document.getElementById(
            "btnNuevoProd",
        ) as HTMLButtonElement;
        const panelProducto = document.getElementById(
            "panelProducto",
        ) as HTMLElement;

        const prodId = document.getElementById("prodId") as HTMLInputElement;
        const prodCodigo = document.getElementById(
            "prodCodigo",
        ) as HTMLInputElement;
        const prodNombre = document.getElementById(
            "prodNombre",
        ) as HTMLInputElement;
        const prodCantidad = document.getElementById(
            "prodCantidad",
        ) as HTMLInputElement;
        const prodCosto = document.getElementById(
            "prodCosto",
        ) as HTMLInputElement;
        const prodVenta = document.getElementById(
            "prodVenta",
        ) as HTMLInputElement;
        const groupVenta = document.getElementById("groupVenta") as HTMLElement;

        const chkSeriales = document.getElementById(
            "chkSeriales",
        ) as HTMLInputElement;
        const panelSeriales = document.getElementById(
            "panelSeriales",
        ) as HTMLElement;
        const inputsSeriales = document.getElementById(
            "inputsSeriales",
        ) as HTMLElement;

        const btnAgregarLista = document.getElementById(
            "btnAgregarLista",
        ) as HTMLButtonElement;
        const tbDetalles = document.getElementById(
            "tbDetalles",
        ) as HTMLTableSectionElement;
        const lblTotalCalculado = document.getElementById(
            "lblTotalCalculado",
        ) as HTMLElement;
        const montoTotalFactura = document.getElementById(
            "montoTotal",
        ) as HTMLInputElement;
        const errorTotal = document.getElementById("errorTotal") as HTMLElement;
        const formCompra = document.getElementById(
            "formCompra",
        ) as HTMLFormElement;

        // Inicializar buscador de productos
        const moduloProductos = crearModuloProductos({
            productoSelect,
            cantidadInput: prodCantidad,
            onNoEncontrado: (err: any) => console.error(err),
        });

        productoSelect.addEventListener("change", async () => {
            const selectedId = productoSelect.value;
            if (!selectedId) return;

            try {
                const response = await fetch(`/api/productos/${selectedId}`);
                if (response.ok) {
                    const p = await response.json();
                    seleccionarProducto(p);
                } else {
                    mostrarError("Error al obtener producto desde el servidor: " + response.status);
                }
            } catch (err) {
                console.error("Error al obtener producto", err);
                mostrarError("Error de red al obtener el producto");
            }
        });

        const seleccionarProducto = (p: any) => {
            modoNuevo = false;
            prodId.value = p.id ? String(p.id) : "";
            prodCodigo.value = p.codigo || "";
            prodCodigo.readOnly = true;
            prodNombre.value = p.nombre || "";
            prodNombre.readOnly = true;
            prodCosto.value = p.costo ? String(p.costo) : "0.00";
            groupVenta.style.display = "none";
            panelProducto.style.display = "block";
            chkSeriales.checked = false;
            panelSeriales.style.display = "none";
        };

        btnNuevoProd.addEventListener("click", () => {
            modoNuevo = true;
            prodId.value = "";
            prodCodigo.value = "";
            prodCodigo.readOnly = false;
            prodNombre.value = "";
            prodNombre.readOnly = false;
            prodCosto.value = "0.00";
            prodVenta.value = "0.00";
            groupVenta.style.display = "flex";
            panelProducto.style.display = "block";
            chkSeriales.checked = false;
            panelSeriales.style.display = "none";
            reiniciarBusquedaProductos();
            prodCodigo.focus();
        });

        // Generar inputs seriales dinámicamente
        const renderSerialInputs = () => {
            if (!chkSeriales.checked) {
                panelSeriales.style.display = "none";
                return;
            }
            panelSeriales.style.display = "block";
            const qty = parseInt(prodCantidad.value) || 0;
            inputsSeriales.innerHTML = "";
            for (let i = 0; i < qty; i++) {
                const input = document.createElement("input");
                input.type = "text";
                input.className = "in-serial";
                input.placeholder = `Serial #${i + 1}`;
                inputsSeriales.appendChild(input);
            }
        };

        chkSeriales.addEventListener("change", renderSerialInputs);
        prodCantidad.addEventListener("input", renderSerialInputs);

        // Agregar a la lista
        btnAgregarLista.addEventListener("click", () => {
            const codigo = prodCodigo.value.trim();
            const nombre = prodNombre.value.trim();
            const cantidad = parseInt(prodCantidad.value) || 0;
            const costo = parseFloat(prodCosto.value) || 0;

            if (!codigo || !nombre || cantidad <= 0 || costo < 0) {
                mostrarError(
                    "Complete correctamente los datos del producto (Código, Nombre, Cantidad > 0, Costo >= 0)",
                );
                return;
            }

            let serialesArr: string[] = [];
            if (chkSeriales.checked) {
                const inps = inputsSeriales.querySelectorAll(".in-serial");
                let vacios = false;
                inps.forEach((el) => {
                    const i = el as HTMLInputElement;
                    const v = i.value.trim();
                    if (!v) vacios = true;
                    else serialesArr.push(v);
                });
                if (vacios || serialesArr.length !== cantidad) {
                    mostrarError("Debe completar todos los números de serie.");
                    return;
                }
            }

            // check duplicate in cart
            const index = carrito.findIndex((c) => c.codigo === codigo);
            if (index >= 0) {
                mostrarError(
                    "Ese producto ya está en la lista. Si desea modificarlo, elimínelo primero.",
                );
                return;
            }

            carrito.push({
                id: prodId.value ? prodId.value : null,
                codigo,
                nombre,
                cantidad,
                costo,
                venta: modoNuevo ? parseFloat(prodVenta.value) || 0 : undefined,
                seriales: serialesArr.length > 0 ? serialesArr : undefined,
            });

            panelProducto.style.display = "none";
            reiniciarBusquedaProductos();
            renderCarrito();
        });

        const renderCarrito = async () => {
            const tasas = await obtenerTasas();
            const monedaBase = obtenerMonedaBase();

            tbDetalles.innerHTML = "";
            let sum = 0;
            carrito.forEach((item, i) => {
                const sub = item.cantidad * item.costo;
                sum += sub;

                const costoMonto = desgloseMontos(item.costo, monedaBase, tasas);
                const costoHtml = `<strong>${costoMonto.principal}</strong><br /><span style="font-size: 0.78rem; color: var(--text-muted);">${costoMonto.secundarias}</span>`;
                
                const subMonto = desgloseMontos(sub, monedaBase, tasas);
                const subHtml = `<strong>${subMonto.principal}</strong><br /><span style="font-size: 0.78rem; color: var(--text-muted);">${subMonto.secundarias}</span>`;

                const tr = document.createElement("tr");
                tr.innerHTML = `
                    <td>${item.codigo} ${item.id === null ? '<span class="text-error text-sm">(NUEVO)</span>' : ""}</td>
                    <td>${item.nombre}</td>
                    <td>${costoHtml}</td>
                    <td>${item.cantidad}</td>
                    <td>${subHtml}</td>
                    <td class="text-sm">${item.seriales ? item.seriales.length + " seriales" : "N/A"}</td>
                    <td style="text-align: center;">
                        <button type="button" onclick="window.eliminarItem(${i})" title="Eliminar producto" style="display:inline-flex; align-items:center; justify-content:center; padding:0.5rem; border-radius:8px; border:none; background:rgba(239, 68, 68, 0.1); color:rgb(239, 68, 68); cursor:pointer; transition:all 0.2s;" onmouseover="this.style.background='rgba(239, 68, 68, 0.2)'" onmouseout="this.style.background='rgba(239, 68, 68, 0.1)'">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"></path><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
                        </button>
                    </td>
                `;
                tbDetalles.appendChild(tr);
            });
            
            const totalMonto = desgloseMontos(sum, monedaBase, tasas);
            lblTotalCalculado.dataset.valor = sum.toString();
            lblTotalCalculado.innerHTML = `
                <strong style="font-size: 1.75rem; color: var(--primary-color); line-height: 1;">${totalMonto.principal}</strong>
                <span style="font-size: 1.05rem; color: var(--text-muted); font-weight: 500; margin-top: 0.5rem;">${totalMonto.secundarias}</span>
            `;

            const seccionTabla = document.getElementById("seccionTablaCompras");
            const seccionConfirmar = document.getElementById("seccionConfirmar");
            
            if (carrito.length === 0) {
                if (seccionTabla) seccionTabla.style.display = "none";
                if (seccionConfirmar) seccionConfirmar.style.display = "none";
            } else {
                if (seccionTabla) seccionTabla.style.display = "block";
                if (seccionConfirmar) seccionConfirmar.style.display = "block";
            }
            
            validarTotales();
        };

        (window as any)["eliminarItem"] = (idx: number) => {
            carrito.splice(idx, 1);
            renderCarrito();
        };

        const validarTotales = () => {
            const tc = parseFloat(lblTotalCalculado.dataset.valor || lblTotalCalculado.textContent || "0") || 0;
            const tf = parseFloat(montoTotalFactura.value) || 0;
            if (Math.abs(tc - tf) > 0.01) {
                errorTotal.style.display = "flex";
                return false;
            }
            errorTotal.style.display = "none";
            return true;
        };

        montoTotalFactura.addEventListener("input", validarTotales);

        formCompra.addEventListener("submit", async (e) => {
            e.preventDefault();

            if (carrito.length === 0) {
                mostrarError("Agregue al menos un producto a la compra.");
                return;
            }

            if (!validarTotales()) {
                mostrarError(
                    "El total de la factura no coincide con la suma de los productos.",
                );
                return;
            }

            const data = {
                fecha: (document.getElementById("fecha") as HTMLInputElement)
                    .value,
                proveedor: (
                    document.getElementById("proveedor") as HTMLInputElement
                ).value.trim(),
                monto_total: parseFloat(montoTotalFactura.value),
                productos: carrito,
            };

            const btnSave = document.getElementById(
                "btnGuardarCompra",
            ) as HTMLButtonElement;
            if (btnSave) {
                btnSave.disabled = true;
                btnSave.textContent = "Guardando...";
            }

            try {
                const res = await fetch("/api/compras", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify(data),
                });

                if (res.ok) {
                    mostrarMensaje("Compra registrada exitosamente.");
                    setTimeout(() => {
                        window.location.href = "/compras";
                    }, 1500);
                } else {
                    const err = await res.json();
                    mostrarError(err.error || "Error al guardar la compra");
                    if (btnSave) {
                        btnSave.disabled = false;
                        btnSave.textContent = "Guardar Compra";
                    }
                }
            } catch (error) {
                mostrarError("Error de red al guardar la compra.");
                if (btnSave) {
                    btnSave.disabled = false;
                    btnSave.textContent = "Guardar Compra";
                }
            }
        });

        const btnSaveFuera = document.getElementById("btnGuardarCompra");
        if (btnSaveFuera) {
            btnSaveFuera.addEventListener("click", () => {
                formCompra.dispatchEvent(
                    new Event("submit", { cancelable: true }),
                );
            });
        }
    };

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", init);
    } else {
        init();
    }
</script>
