---
import Layout from '../../layouts/Layout.astro';
import { verificarToken } from '@/utils/auth.js';

const usuario = verificarToken(Astro.request);
if (!usuario) {
    return Astro.redirect('/login');
}
if (usuario.rol !== 'admin') {
    return Astro.redirect('/');
}

const productoId = Astro.url.searchParams.get('id');
const tipoParam = Astro.url.searchParams.get('tipo');
const tipo = tipoParam === 'salida' ? 'salida' : tipoParam === 'entrada' ? 'entrada' : null;

if (!productoId || !tipo) {
    return Astro.redirect('/productos');
}

const esSalida = tipo === 'salida';
---

<Layout>
    <header class="page-header">
        <p class="eyebrow">Inventario</p>
        <h1>{esSalida ? 'Sacar stock' : 'Agregar stock'}</h1>
        <p class="page-intro">
            {esSalida
                ? 'Registra una salida de inventario con cantidad y motivo. Queda en el historial con usuario, fecha y hora.'
                : 'Suma unidades al inventario. El movimiento queda registrado en el historial.'}
        </p>
    </header>

    <div class="btn-add_container">
        <a class="btn-add" href="/productos">Regresar</a>
    </div>

    <div class="informacion">
        <span id="codigo" class="codigo"></span>
        <h3 id="nombre" class="nombre"></h3>
        <p>Cantidad actual en inventario: <span id="stockViejo" class="span"></span> <strong id="unidadMedida"></strong>.</p>
    </div>

    <section class="form-container page-form">
        <form id="formulario">
            <div class="form-field">
                <label for="cantidad">{esSalida ? 'Unidades a sacar' : 'Unidades a agregar'}</label>
                <input
                    type="text"
                    name="cantidad"
                    id="cantidad"
                    placeholder={esSalida ? 'Ej. 4' : 'Ej. 12'}
                    min="0"
                />
            </div>
            <div class="form-field">
                <label for="motivo">Motivo {esSalida ? '' : '(opcional)'}</label>
                <input
                    type="text"
                    name="motivo"
                    id="motivo"
                    placeholder={esSalida ? 'Ej. Merma, uso interno, ajuste' : 'Ej. Compra a proveedor'}
                />
            </div>
            <div class="form-actions">
                <button type="submit">{esSalida ? 'Registrar salida' : 'Agregar al inventario'}</button>
            </div>
        </form>
    </section>

    <div id="overlay" class="overlay oculto">
        <div id="modal" class="modal"></div>
    </div>
</Layout>

<script>
    import { mostrarError, mostrarMensaje, confirmarAccion } from '@/utils/helpers/mensajes.js';

    const params = new URLSearchParams(window.location.search);
    const id = params.get('id');
    const tipo = params.get('tipo') === 'salida' ? 'salida' : 'entrada';
    const esSalida = tipo === 'salida';

    const nombre = document.querySelector('#nombre') as HTMLElement;
    const codigo = document.querySelector('#codigo') as HTMLElement;
    const stock = document.querySelector('#stockViejo') as HTMLElement;
    const unidadMedida = document.querySelector('#unidadMedida') as HTMLElement;

    document.addEventListener('DOMContentLoaded', rellenarCampos);

    async function rellenarCampos() {
        const response = await fetch(`/api/productos/${id}`);
        const producto = await response.json();

        if (!response.ok) {
            mostrarError(producto.message || 'No se pudo cargar el producto');
            return;
        }

        codigo.textContent = String(producto.codigo || '').toUpperCase();
        nombre.textContent = String(producto.nombre || '').toUpperCase();
        stock.textContent = producto.stock;
        unidadMedida.textContent = producto.unidad_medida;
    }

    const formulario = document.getElementById('formulario') as HTMLFormElement;

    formulario.addEventListener('submit', async (event: SubmitEvent) => {
        event.preventDefault();

        const formData = new FormData(formulario);
        const cantidadTexto = String(formData.get('cantidad') ?? '').trim();
        const motivo = String(formData.get('motivo') ?? '').trim();

        if (!cantidadTexto) {
            mostrarError(esSalida ? 'Ingresa cuántas unidades vas a sacar' : 'Ingresa cuántas unidades vas a agregar');
            return;
        }

        const normalizado = cantidadTexto.replace(',', '.');
        const cantidadValida = /^\d+(\.\d+)?$/.test(normalizado);
        const cantidad = parseFloat(normalizado);

        if (!cantidadValida || isNaN(cantidad) || cantidad <= 0) {
            mostrarError('La cantidad debe ser un número positivo mayor a 0');
            return;
        }

        if (esSalida && !motivo) {
            mostrarError('El motivo es obligatorio para sacar stock');
            return;
        }

        const confirmar = await confirmarAccion(
            esSalida
                ? `¿Sacar ${cantidadTexto} unidades del inventario?`
                : `¿Agregar ${cantidadTexto} unidades al inventario?`,
            {
                titulo: esSalida ? 'Sacar stock' : 'Agregar stock',
                textoAceptar: esSalida ? 'Sacar' : 'Agregar',
            }
        );
        if (!confirmar) return;

        const response = await fetch('/api/productos/movimientos', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ productoId: id, tipo, cantidad, motivo }),
        });

        const data = await response.json().catch(() => ({}));

        if (!response.ok) {
            mostrarError(data.error || data.message || 'Error al registrar el movimiento');
            return;
        }

        mostrarMensaje(data.message);
        setTimeout(() => {
            window.location.href = `/productos/historial?id=${id}`;
        }, 1000);
    });
</script>

<style>
    .informacion {
        background: rgba(255, 255, 255, 0.82);
        padding: 1.1rem 1.2rem;
        border-radius: 18px;
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
        border: 1px solid rgba(var(--secondary-rgb), 0.08);
        box-shadow: 0 18px 32px rgba(var(--primary-rgb), 0.08);
        margin-bottom: 1.2rem;
    }

    .informacion .codigo {
        font-size: 0.86rem;
        font-weight: 700;
        letter-spacing: 0.06em;
        color: var(--text-muted);
    }

    .informacion .nombre {
        font-size: 1.2rem;
        font-weight: 700;
        margin: 0;
        color: var(--secondary-color);
    }

    .informacion p {
        font-size: 0.92rem;
        color: var(--text-color);
        margin: 0;
    }

    .informacion .span {
        font-size: 1.1rem;
        font-weight: 700;
    }
</style>
