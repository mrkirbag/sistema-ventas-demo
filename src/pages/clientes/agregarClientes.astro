---
import Layout from '../../layouts/Layout.astro';
import { verificarToken } from '../../utils/auth.js';

const usuario = verificarToken(Astro.request);
if (!usuario) {
    return Astro.redirect('/login');
}
---

<Layout>
    <header class="page-header">
        <p class="eyebrow">Gestión comercial</p>
        <h1>Agregar cliente</h1>
        <p class="page-intro">Registra un nuevo cliente con nombre, cédula o RIF y teléfono.</p>
    </header>

    <div class="btn-add_container">
        <a class="btn-add" href="/clientes">Regresar</a>
    </div>

    <section class="form-container page-form">
        <form id="formulario">
            <div class="form-field">
                <label for="nombre">Nombre y apellido</label>
                <input
                    type="text"
                    name="nombre"
                    id="nombre"
                    placeholder="Ej. Carlos Pérez"
                    maxlength="80"
                />
            </div>

            <div class="form-field">
                <label for="cedula">Cédula o RIF</label>
                <input
                    type="text"
                    name="cedula"
                    id="cedula"
                    placeholder="Ej. 12345678 o J-12345678-9"
                    maxlength="15"
                />
            </div>

            <div class="form-field">
                <label for="telefono">Teléfono</label>
                <input
                    type="text"
                    name="telefono"
                    id="telefono"
                    placeholder="Ej. 04141234567"
                    maxlength="20"
                />
            </div>

            <div class="form-actions">
                <button type="submit">Agregar cliente</button>
            </div>
        </form>
    </section>

    <div id="overlay" class="overlay oculto"> 
        <div id="modal" class="modal"></div>
    </div>

</Layout>

<script>
    import { mostrarError, mostrarMensaje } from '@/utils/helpers/mensajes.js';
    import { validarCliente } from '@/utils/clienteValidaciones.js';

    const formulario = document.getElementById('formulario') as HTMLFormElement;

    formulario.addEventListener('submit', async (event : SubmitEvent) => { 
        event.preventDefault();

        const formData = new FormData(formulario);
        const validado = validarCliente({
            nombre: formData.get('nombre'),
            cedula: formData.get('cedula'),
            telefono: formData.get('telefono'),
        });

        if (!validado.ok) {
            mostrarError(validado.error);
            return;
        }

        const response = await fetch("/api/clientes", {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(validado.cliente)
        });

        if (!response.ok) {
            const raw = await response.text();
            let mensaje = raw || `Error al agregar cliente: ${response.status}`;
            try {
                const data = JSON.parse(raw);
                mensaje = data.error || data.message || mensaje;
            } catch {}
            mostrarError(mensaje);
            return;
        }

        const data = await response.json();
        mostrarMensaje(data.message);
        setTimeout(() => {
            window.location.href = '/clientes';
        }, 1000);
    });
</script>
