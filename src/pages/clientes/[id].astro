---
import Layout from '../../layouts/Layout.astro';
import { verificarToken } from '../../utils/auth.js';

const usuario = verificarToken(Astro.request);
if (!usuario) {
    return Astro.redirect('/login');
}
---

<Layout>
    <header class="page-header">
        <p class="eyebrow">Gestión comercial</p>
        <h1>Editar cliente</h1>
        <p class="page-intro">Actualiza el nombre, la cédula o RIF y el teléfono del cliente.</p>
    </header>

    <div class="btn-add_container">
        <a class="btn-add" href="/clientes">Regresar</a>
    </div>

    <section class="form-container page-form">
        <form id="formulario">
            <div class="form-field">
                <label for="nombre">Nombre y apellido</label>
                <input type="text" name="nombre" id="nombre" placeholder="Ej. Carlos Pérez" maxlength="80" />
            </div>
            <div class="form-field">
                <label for="cedula">Cédula o RIF</label>
                <input type="text" name="cedula" id="cedula" placeholder="Ej. 12345678 o J-12345678-9" maxlength="15" />
            </div>
            <div class="form-field">
                <label for="telefono">Teléfono</label>
                <input type="text" name="telefono" id="telefono" placeholder="Ej. 04141234567" maxlength="20" />
            </div>

            <div class="form-actions">
                <button type="submit">Actualizar</button>
            </div>
        </form>
    </section>

    <div id="overlay" class="overlay oculto"> 
        <div id="modal" class="modal"></div>
    </div>

</Layout>

<script>
    import { mostrarError, mostrarMensaje } from '@/utils/helpers/mensajes.js';
    import { validarCliente } from '@/utils/clienteValidaciones.js';

    const idCliente = location.pathname.split("/").pop() as string;
    const nombre = document.querySelector("#nombre") as HTMLInputElement;
    const telefono = document.querySelector("#telefono") as HTMLInputElement;
    const cedula = document.querySelector("#cedula") as HTMLInputElement;

    document.addEventListener('DOMContentLoaded', rellenarCampos);

    async function rellenarCampos(){
        const response = await fetch(`/api/clientes/${idCliente}`);
        const cliente = await response.json();

        if (!response.ok) {
            mostrarError(cliente.message || 'No se pudo cargar el cliente');
            return;
        }

        nombre.value = cliente.nombre ?? '';
        telefono.value = cliente.telefono ?? '';
        cedula.value = cliente.cedula ?? '';
    }

    const formulario = document.getElementById('formulario') as HTMLFormElement;

    formulario.addEventListener('submit', async (event) => { 
        event.preventDefault();

        const formData = new FormData(formulario);
        const validado = validarCliente({
            nombre: formData.get('nombre'),
            cedula: formData.get('cedula'),
            telefono: formData.get('telefono'),
        });

        if (!validado.ok) {
            mostrarError(validado.error);
            return;
        }

        const response = await fetch("/api/clientes", {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ idCliente, ...validado.cliente }),
        });

        if (!response.ok) {
            const raw = await response.text();
            let mensaje = raw || `Error al editar cliente: ${response.status}`;
            try {
                const data = JSON.parse(raw);
                mensaje = data.error || data.message || mensaje;
            } catch {}
            mostrarError(mensaje);
            return;
        }

        const data = await response.json();
        mostrarMensaje(data.message);
        setTimeout(() => {
            window.location.href = '/clientes';
        }, 1000);
    });
</script>
