---
import Layout from '../../layouts/Layout.astro';
import { verificarToken } from '@/utils/auth.js';

const usuario = verificarToken(Astro.request);
if (!usuario) {
    return Astro.redirect('/login');
}

const fechaVenezuela = new Intl.DateTimeFormat('es-VE', {
    timeZone: 'America/Caracas',
    day: '2-digit',
    month: '2-digit',
    year: 'numeric',
}).format(new Date());

const [dia, mes, ano] = fechaVenezuela.split('/');
const fechaCompleta = `${ano}-${mes}-${dia}`;
---

<Layout>
    <header class="page-header">
        <p class="eyebrow">Gestión comercial</p>
        <h1>Agregar cotización</h1>
        <p class="page-intro">Registra los datos del cliente, arma la cotización con productos del inventario y guárdala para consultarla después.</p>
    </header>

    <div class="btn-add_container">
        <a class="btn-add" href="/cotizaciones">Regresar</a>
    </div>

    <main class="cotizacion-flow">
        <section class="cotizacion-panel">
            <div class="panel-heading">
                <span class="step-badge">1</span>
                <div>
                    <p class="eyebrow">Cliente</p>
                    <h2>Datos del cliente</h2>
                </div>
            </div>

            <section class="form-container page-form cotizacion-form">
                <div class="cliente-module">
                    <div class="form-field">
                        <label for="clienteNombre">Nombre y apellido</label>
                        <input
                            type="text"
                            id="clienteNombre"
                            placeholder="Ej. Carlos Pérez"
                            autocomplete="name"
                            maxlength="80"
                        />
                    </div>

                    <div class="form-field">
                        <label for="clienteCedulaRif">Cédula / RIF</label>
                        <input
                            type="text"
                            id="clienteCedulaRif"
                            placeholder="Ej. 12345678 o J-12345678-9"
                            autocomplete="off"
                            maxlength="15"
                        />
                    </div>

                    <div class="form-field">
                        <label for="clienteTelefono">Teléfono</label>
                        <input
                            type="text"
                            id="clienteTelefono"
                            placeholder="Ej. 04141234567"
                            autocomplete="tel"
                            maxlength="20"
                        />
                    </div>

                    <div class="form-field cliente-module_direccion">
                        <label for="clienteDireccion">Dirección</label>
                        <input
                            type="text"
                            id="clienteDireccion"
                            placeholder="Ej. Av. Principal, Edificio 5, Apto 3"
                            autocomplete="street-address"
                            maxlength="120"
                        />
                    </div>

                    <div class="form-field">
                        <label for="fecha">Fecha de cotización</label>
                        <input type="date" id="fecha" value={fechaCompleta} />
                    </div>
                </div>
            </section>
        </section>

        <section class="cotizacion-panel">
            <div class="panel-heading">
                <span class="step-badge">2</span>
                <div>
                    <p class="eyebrow">Productos</p>
                    <h2>Agregar a la cotización</h2>
                </div>
            </div>

            <section class="form-container page-form cotizacion-form">
                <form onsubmit="return false;">
                    <div id="productos-container" class="producto-module">
                        <div class="form-field producto-module_search">
                            <label for="busquedaProductos">Buscar producto</label>
                            <input
                                type="text"
                                id="busquedaProductos"
                                placeholder="Nombre o codigo del producto"
                                autocomplete="off"
                            />
                        </div>

                        <div class="form-field producto-module_select">
                            <label for="productoSelect">Producto</label>
                            <select name="producto" id="productoSelect"></select>
                        </div>

                        <div class="form-field">
                            <label for="cantidad">Cantidad</label>
                            <input type="number" min="1" id="cantidad" placeholder="Ej. 2"/>
                        </div>

                        <div class="form-field">
                            <label for="precio">Precio por unidad (USD)</label>
                            <input type="text" id="precio" placeholder="0.00"/>
                            <span class="precio-referencia" id="precioReferencia">Referencia: 0 COP</span>
                        </div>

                        <div class="form-actions producto-module_actions">
                            <button type="button" id="agregarProducto">Agregar producto</button>
                        </div>
                    </div>
                </form>
            </section>
        </section>

        <section class="cotizacion-panel invoice-table-card">
            <div class="table-heading">
                <div>
                    <p class="eyebrow">Detalle</p>
                    <h2>Productos cotizados</h2>
                </div>
                <p class="table-caption">Revisa cantidades y subtotales antes de imprimir.</p>
            </div>

            <div class="table-wrap">
                <table id="contenidoImpresion">
                    <thead id="headerTablaProductos" style="opacity: 0;">
                        <tr>
                            <th>Producto</th>
                            <th>Precio por unidad</th>
                            <th>Cantidad</th>
                            <th>Subtotal</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody id="listaProductos">
                    </tbody>
                </table>
            </div>
        </section>

        <section class="cotizacion-summary-card" aria-live="polite">
            <div class="summary-icon" aria-hidden="true">$</div>
            <div>
                <p class="summary-eyebrow">Estado de la cotización</p>
                <p class="summary-text" id="resumenCotizacion">Completa los datos del cliente y agrega productos para comenzar la cotización.</p>
                <p class="summary-subtext" id="resumenItems"></p>
            </div>
        </section>

        <section class="cotizacion-footer" id="cotizacionFooter" hidden>
            <section class="total-box" id="totalResumen">
                <p class="total-box_label">Total de la cotización</p>
                <div class="total-box_values">
                    <div>
                        <span class="total-box_caption">USD</span>
                        <strong id="totalUSD">0.00</strong>
                    </div>
                    <div>
                        <span class="total-box_caption">COP</span>
                        <strong id="totalCOP">0</strong>
                    </div>
                </div>
            </section>

            <div class="btns-container" id="btns">
                <button type="button" id="guardarCotizacion" disabled>Guardar cotización</button>
                <button type="button" id="reiniciar" class="btn-secundario" disabled>Cancelar</button>
            </div>
        </section>
    </main>

    <div id="mensaje"></div>
    <div id="overlay" class="overlay oculto">
        <div id="modal" class="modal"></div>
    </div>
</Layout>

<style>
    .cotizacion-flow {
        display: flex;
        flex-direction: column;
        gap: 1.2rem;
    }

    .cotizacion-panel,
    .invoice-table-card {
        border-radius: 22px;
        background: rgba(255, 255, 255, 0.82);
        border: 1px solid rgba(var(--secondary-rgb), 0.08);
        box-shadow: 0 18px 32px rgba(var(--primary-rgb), 0.08);
    }

    .cotizacion-panel {
        padding: 1.15rem;
    }

    .panel-heading {
        display: flex;
        align-items: center;
        gap: 0.9rem;
        margin-bottom: 1rem;
    }

    .step-badge {
        display: grid;
        place-items: center;
        width: 42px;
        height: 42px;
        border-radius: 14px;
        background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
        color: #fff;
        font-family: "Archivo Black", sans-serif;
        font-size: 1rem;
        flex-shrink: 0;
        box-shadow: 0 10px 20px rgba(var(--primary-rgb), 0.18);
    }

    .panel-heading h2 {
        margin: 0;
        font-size: 1.2rem;
    }

    .cotizacion-form {
        width: 100%;
        margin: 0;
        padding: 0;
        background: transparent;
        border: none;
        box-shadow: none;
        backdrop-filter: none;
    }

    .cliente-module,
    .producto-module {
        grid-column: 1 / -1;
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.85rem 1rem;
        padding: 1.1rem;
        border-radius: var(--radius-md);
        background: linear-gradient(180deg, rgba(236, 231, 246, 0.5), rgba(255, 255, 255, 0.72));
        border: 1px solid rgba(var(--secondary-rgb), 0.08);
    }

    .cliente-module_direccion,
    .producto-module_search,
    .producto-module_select,
    .producto-module_actions {
        grid-column: 1 / -1;
    }

    .precio-referencia {
        margin-top: 0.35rem;
        font-size: 0.78rem;
        font-weight: 700;
        color: var(--secondary-color);
    }

    .invoice-table-card {
        padding: 1.15rem;
    }

    .table-heading {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 1rem;
        margin-bottom: 1rem;
    }

    .table-heading h2 {
        margin: 0;
        font-size: 1.2rem;
    }

    .table-caption {
        font-size: 0.74rem;
        font-weight: 800;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #4f3d78;
        text-align: right;
        max-width: 28ch;
        line-height: 1.5;
    }

    .cotizacion-summary-card {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1rem 1.15rem;
        border-radius: var(--radius-lg);
        background: linear-gradient(135deg, rgba(var(--secondary-rgb), 0.06), rgba(217, 209, 236, 0.42));
        border: 1px solid rgba(var(--secondary-rgb), 0.1);
        box-shadow: var(--shadow-card);
    }

    .summary-icon {
        display: grid;
        place-items: center;
        width: 52px;
        height: 52px;
        border-radius: 16px;
        background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
        color: #fff;
        font-family: "Archivo Black", sans-serif;
        font-size: 1.35rem;
        flex-shrink: 0;
        box-shadow: 0 10px 22px rgba(var(--primary-rgb), 0.2);
    }

    .summary-eyebrow {
        margin: 0 0 0.2rem;
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--secondary-color);
    }

    .summary-text {
        margin: 0;
        font-size: 0.95rem;
        font-weight: 600;
        color: var(--primary-strong);
        line-height: 1.5;
    }

    .summary-subtext {
        margin: 0.25rem 0 0;
        font-size: 0.82rem;
        color: var(--text-muted);
        font-weight: 600;
    }

    .cotizacion-footer {
        display: grid;
        gap: 1rem;
    }

    .cotizacion-footer[hidden] {
        display: none;
    }

    .total-box {
        width: min(100%, 420px);
        margin: 0 0 0 auto;
        padding: 1rem 1.1rem;
        border-radius: 22px;
        background: linear-gradient(135deg, #dbeafe, #bfdbfe);
        color: #0f172a;
        border: 1px solid rgba(37, 99, 235, 0.18);
        box-shadow: 0 18px 28px rgba(37, 99, 235, 0.14);
    }

    .total-box.is-empty {
        background: linear-gradient(135deg, #eff6ff, #dbeafe);
    }

    .total-box p,
    .total-box span,
    .total-box strong {
        color: inherit;
    }

    .total-box_label {
        margin: 0 0 0.75rem;
        font-size: 0.76rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: #1d4ed8;
    }

    .total-box_values {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.85rem;
    }

    .total-box_values div {
        display: grid;
        gap: 0.25rem;
        padding: 0.85rem 0.9rem;
        border-radius: 16px;
        background: rgba(255, 255, 255, 0.72);
        border: 1px solid rgba(59, 130, 246, 0.2);
    }

    .total-box_caption {
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #2563eb;
    }

    .total-box strong {
        font-size: 1.25rem;
        line-height: 1;
        color: #0f172a;
    }

    .btns-container {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.75rem;
    }

    .btns-container button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 148px;
        min-height: 44px;
        background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
        color: #fff;
        border-radius: 999px;
        padding: 0.72rem 1rem;
        font-size: 0.84rem;
        font-weight: 700;
        letter-spacing: 0.02em;
        border: none;
        box-shadow: 0 10px 24px rgba(var(--primary-rgb), 0.22);
        transition: transform 160ms ease, box-shadow 160ms ease, background-color 160ms ease;
    }

    .btns-container button:hover:not(:disabled) {
        transform: translateY(-1px);
        box-shadow: 0 14px 28px rgba(var(--primary-rgb), 0.28);
        cursor: pointer;
    }

    .btns-container button:disabled {
        cursor: not-allowed;
        opacity: 0.55;
        box-shadow: none;
        transform: none;
    }

    .btn-secundario {
        background: rgba(var(--primary-rgb), 0.08) !important;
        color: var(--secondary-color) !important;
        border: 1px solid rgba(var(--secondary-rgb), 0.16) !important;
        box-shadow: none !important;
    }

    .btn-secundario:hover:not(:disabled) {
        background: rgba(var(--primary-rgb), 0.12) !important;
        box-shadow: none !important;
    }

    :global(.monto-usd) {
        font-weight: 700;
        color: var(--primary-strong);
    }

    :global(.monto-cop) {
        font-size: 0.78rem;
        color: var(--text-muted);
    }

    @media (max-width: 768px) {
        .cliente-module,
        .producto-module {
            grid-template-columns: 1fr;
        }

        .table-heading {
            flex-direction: column;
        }

        .table-caption {
            text-align: left;
            max-width: none;
        }

        .cotizacion-summary-card {
            align-items: flex-start;
            padding: 0.9rem 1rem;
        }

        .total-box {
            width: 100%;
            margin-inline: 0;
        }

        .total-box_values {
            grid-template-columns: 1fr;
        }

        .btns-container {
            justify-content: stretch;
        }

        .btns-container button {
            width: 100%;
            min-width: 0;
        }
    }
</style>

<script >

    import { cambioUSDaCOP } from "@/utils/helpers/cambioMoneda";
    import { mostrarError, mostrarMensaje } from "@/utils/helpers/mensajes";
    import { ponerIcono } from '@/utils/helpers/iconosAccion.js';
    import { validarCliente } from '@/utils/clienteValidaciones.js';
    import {
        crearModuloProductos,
        enfocarBusquedaProductos,
        reiniciarBusquedaProductos,
    } from '@/utils/helpers/seleccionProducto.js';

    let moduloProductos: ReturnType<typeof crearModuloProductos> | null = null;
    let productosSeleccionados: ProductoSeleccionado[] = [];
    let totalDeCotizacion = 0;

    interface ProductoSeleccionado {
        id: number;
        codigo: string;
        nombre: string;
        precio: number;
        cantidad: number;
        subtotal: number;
    }

    const productoSelect = document.getElementById("productoSelect") as HTMLSelectElement;
    const precioInput = document.getElementById("precio") as HTMLInputElement;
    const precioReferencia = document.getElementById("precioReferencia") as HTMLSpanElement;
    const clienteNombreInput = document.getElementById("clienteNombre") as HTMLInputElement;
    const clienteCedulaRifInput = document.getElementById("clienteCedulaRif") as HTMLInputElement;
    const clienteTelefonoInput = document.getElementById("clienteTelefono") as HTMLInputElement;
    const clienteDireccionInput = document.getElementById("clienteDireccion") as HTMLInputElement;

    function obtenerDatosCliente() {
        return {
            nombre: clienteNombreInput.value.trim(),
            cedulaRif: clienteCedulaRifInput.value.trim(),
            telefono: clienteTelefonoInput.value.trim(),
            direccion: clienteDireccionInput.value.trim(),
        };
    }

    function validarDatosCliente() {
        const datos = obtenerDatosCliente();
        const validado = validarCliente({
            nombre: datos.nombre,
            cedula: datos.cedulaRif,
            telefono: datos.telefono,
            direccion: datos.direccion,
        });

        if (!validado.ok) {
            mostrarError(validado.error);
            return false;
        }

        clienteNombreInput.value = validado.cliente.nombre;
        clienteCedulaRifInput.value = validado.cliente.cedula;
        clienteTelefonoInput.value = validado.cliente.telefono;
        clienteDireccionInput.value = validado.cliente.direccion ?? datos.direccion;
        return true;
    }

    function toggleCotizacionActiva(activo: boolean) {
        const thead = document.querySelector('#headerTablaProductos') as HTMLTableSectionElement;
        const cotizacionFooter = document.querySelector('#cotizacionFooter') as HTMLElement;
        const btnGuardar = document.querySelector('#guardarCotizacion') as HTMLButtonElement;
        const btnCancelar = document.querySelector('#reiniciar') as HTMLButtonElement;

        thead.style.opacity = activo ? '1' : '0';
        cotizacionFooter.hidden = !activo;
        btnGuardar.disabled = !activo;
        btnCancelar.disabled = !activo;
    }

    (document.querySelector('#guardarCotizacion') as HTMLButtonElement).addEventListener('click', async () => {
        if (!validarDatosCliente()) {
            return;
        }

        const fecha = (document.getElementById('fecha') as HTMLInputElement).value;
        if (!fecha) {
            mostrarError('Selecciona la fecha de la cotización');
            return;
        }

        if (productosSeleccionados.length === 0) {
            mostrarError('Agrega al menos un producto a la cotización');
            return;
        }

        if (isNaN(totalDeCotizacion) || totalDeCotizacion <= 0) {
            mostrarError('El total de la cotización no es válido');
            return;
        }

        const { nombre, cedulaRif, telefono, direccion } = obtenerDatosCliente();

        try {
            const response = await fetch('/api/cotizaciones/completa', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    fecha,
                    clienteNombre: nombre,
                    clienteCedulaRif: cedulaRif,
                    clienteTelefono: telefono,
                    clienteDireccion: direccion,
                    totalDeCotizacion,
                    productos: productosSeleccionados.map(({ id, codigo, nombre, precio, cantidad }) => ({
                        idProducto: id,
                        codigo,
                        nombre,
                        precio,
                        cantidad,
                    })),
                }),
            });

            const data = await response.json();

            if (!response.ok) {
                mostrarError(data.error || 'Error al guardar la cotización');
                return;
            }

            mostrarMensaje('Cotización guardada correctamente');

            setTimeout(() => {
                window.location.href = `/cotizaciones/${data.cotizacionId}`;
            }, 1500);
        } catch (error) {
            console.error('Error al guardar cotización:', error);
            mostrarError('Error al guardar la cotización');
        }
    });

    function actualizarReferenciaPrecio(tasa: number) {
        const precio = parseFloat(precioInput.value);

        if (isNaN(precio) || precio <= 0) {
            precioReferencia.textContent = 'Referencia: 0 COP';
            return;
        }

        precioReferencia.textContent = `Referencia: ${Math.ceil(precio * tasa)} COP`;
    }

    async function aplicarPrecioProducto(producto: Producto) {
        const venta = parseFloat(String(producto.venta ?? ''));

        if (!Number.isNaN(venta) && venta > 0) {
            precioInput.value = venta.toFixed(2);
            const tasa = await cambioUSDaCOP();
            actualizarReferenciaPrecio(tasa);
        } else {
            precioInput.value = "";
            actualizarReferenciaPrecio(await cambioUSDaCOP());
        }
    }

    function iniciarModuloProductos() {
        if (moduloProductos) return;

        const cantidadInput = document.getElementById("cantidad") as HTMLInputElement;

        moduloProductos = crearModuloProductos({
            productoSelect,
            cantidadInput,
            onNoEncontrado: mostrarError,
        });
    }

    function enfocarDatosCliente() {
        clienteNombreInput?.focus();
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', () => {
            iniciarModuloProductos();
            enfocarDatosCliente();
        });
    } else {
        iniciarModuloProductos();
        enfocarDatosCliente();
    }

    precioInput.addEventListener('input', async () => {
        const tasa = await cambioUSDaCOP();
        actualizarReferenciaPrecio(tasa);
    });

    interface Producto {
        codigo: string;
        nombre: string;
        precio: number;
        cantidad: number;
        id: number;

        stock: number;
        costo: number;
        venta: number;
        unidad_medida: string;
    }

    function actualizarResumen(cantidadItems: number, totalUSD = 0, totalCOP = 0) {
        const resumen = document.getElementById('resumenCotizacion') as HTMLParagraphElement;
        const resumenItems = document.getElementById('resumenItems') as HTMLParagraphElement;
        if (!resumen || !resumenItems) return;

        if (cantidadItems === 0) {
            resumen.textContent = 'Completa los datos del cliente y agrega productos para comenzar la cotización.';
            resumenItems.textContent = '';
            return;
        }

        const textoItems = cantidadItems === 1
            ? '1 producto en la cotización'
            : `${cantidadItems} productos en la cotización`;

        resumen.textContent = textoItems;
        resumenItems.textContent = `Total estimado: ${totalUSD.toFixed(2)} USD · ${totalCOP} COP`;
    }

    const btnReiniciar = document.querySelector('#reiniciar') as HTMLButtonElement;
    btnReiniciar.addEventListener('click', () => {
        window.location.href = '/cotizaciones';
    });

    productoSelect.addEventListener("change", async () => {

        const productoId = productoSelect.value;
        const tasa = await cambioUSDaCOP();

        if (!productoId) {
            precioInput.value = "";
            actualizarReferenciaPrecio(tasa);
            return;
        }

        try {
            const response = await fetch(`/api/productos/${productoId}`);

            if (!response.ok) {
                console.error("Error al obtener el producto:", response.status);
                precioInput.value = "";
                actualizarReferenciaPrecio(tasa);
                return;
            }

            const producto = await response.json();

            if (typeof producto.venta === "number") {
                precioInput.value = producto.venta.toFixed(2);
                actualizarReferenciaPrecio(tasa);
            } else if (producto.venta != null && producto.venta !== '') {
                precioInput.value = parseFloat(String(producto.venta)).toFixed(2);
                actualizarReferenciaPrecio(tasa);
            } else {
                precioInput.value = "";
                actualizarReferenciaPrecio(tasa);
            }

        } catch (error) {
            console.error("Error de red o parsing:", error);
            precioInput.value = "";
            actualizarReferenciaPrecio(tasa);
        }
    });

    const btnagregarProducto = document.getElementById("agregarProducto") as HTMLButtonElement;

    btnagregarProducto.addEventListener("click", async (e) => {

        e.preventDefault();

        if (!validarDatosCliente()) {
            return;
        }

        const productoId = productoSelect.value;
        const cantidadInput = document.getElementById("cantidad") as HTMLInputElement;

        const cantidad = parseFloat(cantidadInput.value.replace(',', '.'));
        const precio = parseFloat(precioInput.value.replace(',', '.'));

        try {

            const response = await fetch(`/api/productos/${productoId}`);
            if (!response.ok) {
                throw new Error('Error al obtener el producto: ' + response.status);
            }
            const producto = await response.json();

            if (!producto) {
                mostrarError('Producto no encontrado');
                return;
            }
            if (isNaN(cantidad) || Number(cantidad) <= 0) {
                mostrarError("Ingresa una cantidad válida mayor a cero");
                return;
            }
            if (isNaN(precio) || Number(precio) <= 0) {
                mostrarError("El precio del producto no es válido");
                return;
            }

            let productoSeleccionado = {
                id: producto.id,
                codigo: producto.codigo,
                nombre: producto.nombre,
                cantidad,
                precio,
                subtotal: (precio * cantidad)
            }

            productosSeleccionados.push(productoSeleccionado);
            mostrarProductosEnTabla(productoSeleccionado)
            
        } catch (error) {
            console.error("Error al obtener el producto:", error);
            return;
        }
    });

    async function mostrarProductosEnTabla(productoSeleccionado : ProductoSeleccionado) {
        
        const tbody = document.querySelector('#listaProductos') as HTMLTableSectionElement;
        const cantidadInput = document.getElementById("cantidad") as HTMLInputElement;
        const productoSelect = document.getElementById("productoSelect") as HTMLSelectElement;
        const precioInput = document.getElementById("precio") as HTMLInputElement;

        const tasa = await cambioUSDaCOP();
        let precioPesos = Math.ceil(tasa * productoSeleccionado.precio);
        let subtotalPesos = Math.ceil(tasa * productoSeleccionado.subtotal);

        const tr = document.createElement('tr');
        tr.innerHTML = `
            <td data-label="Producto">
                <strong>${productoSeleccionado.nombre.toUpperCase()}</strong>
                <br />
                <span class="monto-cop">${productoSeleccionado.codigo.toUpperCase()}</span>
            </td>
            <td data-label="Precio por Unidad">
                <span class="monto-usd">${productoSeleccionado.precio.toFixed(2)} USD</span>
                <br />
                <span class="monto-cop">${precioPesos} COP</span>
            </td>
            <td data-label="Cantidad">${productoSeleccionado.cantidad}</td>
            <td data-label="Subtotal">
                <span class="subtotal monto-usd">${productoSeleccionado.subtotal.toFixed(2)} USD</span>
                <br />
                <span class="monto-cop">${subtotalPesos} COP</span>
            </td>
        `;

        const tdAcciones = document.createElement('td');
        tdAcciones.classList.add('acciones');

        const btnEliminar = document.createElement('button');
        btnEliminar.type = 'button';
        btnEliminar.classList.add('btn-eliminar');
        ponerIcono(btnEliminar, 'eliminar');
        btnEliminar.addEventListener('click', () => {
            productosSeleccionados = productosSeleccionados.filter(p => p.codigo !== productoSeleccionado.codigo);
            tr.remove();
            totalizar();
            if (tbody && tbody.querySelectorAll('tr').length <= 0) {
                toggleCotizacionActiva(false);
            }
        });

        tdAcciones.appendChild(btnEliminar);
        tr.appendChild(tdAcciones);
        tbody.appendChild(tr);

        if (tbody && tbody.querySelectorAll('tr').length > 0) {
            toggleCotizacionActiva(true);
        }

        productoSelect.value = "";
        cantidadInput.value = "";
        precioInput.value = "";
        precioReferencia.textContent = 'Referencia: 0 COP';
        reiniciarBusquedaProductos();
        enfocarBusquedaProductos();

        totalizar();
    }

    async function totalizar() {
        const totalResumen = document.querySelector('#totalResumen') as HTMLElement;
        const totalUSDNode = document.querySelector('#totalUSD') as HTMLElement;
        const totalCOPNode = document.querySelector('#totalCOP') as HTMLElement;

        const totalUSD = productosSeleccionados.reduce(
            (suma, producto) => suma + (producto.precio * producto.cantidad),
            0
        );

        const tasa = await cambioUSDaCOP();
        const totalCOP = Math.ceil(tasa * totalUSD);

        totalResumen?.classList.toggle('is-empty', totalUSD <= 0);
        if (totalUSDNode) totalUSDNode.textContent = totalUSD.toFixed(2);
        if (totalCOPNode) totalCOPNode.textContent = totalCOP.toString();
        totalDeCotizacion = totalUSD;

        actualizarResumen(productosSeleccionados.length, totalUSD, totalCOP);
    }

</script>
