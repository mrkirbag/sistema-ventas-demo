---
import Layout from '../layouts/Layout.astro';
import { verificarToken } from '../utils/auth.js';

const usuario = verificarToken(Astro.request);
if (!usuario) {
    return Astro.redirect('/login');
}
if (usuario.rol !== 'admin') {
    return Astro.redirect('/'); 
}
---

<Layout>
    <header class="page-header">
        <p class="eyebrow">Inventario</p>
        <h1>Productos</h1>
        <p class="page-intro">Consulta el catálogo, precios, stock y acciones rápidas de cada producto.</p>
    </header>

    <div class="page-toolbar">
        <div class="toolbar-actions">
            <div class="btn-add_container">
                <a class="btn-add" href="/productos/agregarProductos">Agregar producto</a>
            </div>
            <div class="btn-add_container">
                <a class="btn-add" href="/productos/cargaMasiva">Cargar de Excel</a>
            </div>
            <div class="btn-add_container">
                <a class="btn-add" id="exportarBtn">Exportar a Excel</a>
            </div>
            <div class="btn-add_container">
                <a class="btn-add" href="/productos/historial">Historial de stock</a>
            </div>
        </div>

        <div class="input-busqueda_container">
            <input type="text" id="inputBusqueda" placeholder="Buscar por nombre o código..." />
        </div>
    </div>

    <div class="table-wrap">
    <table>
        <thead id="thead">
            <tr>
                <th>
                    Código
                    <br />
                    Nombre
                </th>
                <th>Cantidad</th>
                <th>Costo Promedio</th>
                <th>Precio Venta</th>
                <th>Acciones</th> 
            </tr>
        </thead>
        <tbody id="listaProductos">
        </tbody>
    </table>
    </div>

    <div class="btn-vermas_container">
        <button id="btnVerAnterior" class="btn-vermas">Anterior</button>
        <button id="btnVerMas" class="btn-vermas">Siguiente</button>
    </div>

    <div id="mensaje"></div>
</Layout>

<script>

    import { noRegistros, confirmarAccion, mostrarError, mostrarMensaje } from "@/utils/helpers/mensajes.js";
    import { obtenerTasas } from "@/utils/helpers/cambioMoneda.js";
    import { desgloseMontos, obtenerMonedaBase } from "@/utils/helpers/tasas.js";
    import { ponerIcono } from "@/utils/helpers/iconosAccion.js";

    document.addEventListener('DOMContentLoaded', async () => {

        // Elementos del DOM
        const thead = document.getElementById('thead') as HTMLTableSectionElement;
        const tbody = document.getElementById('listaProductos') as HTMLTableSectionElement;
        const btnVerMas = document.getElementById('btnVerMas') as HTMLButtonElement;
        const btnVerAnterior = document.getElementById('btnVerAnterior') as HTMLButtonElement;
        const busqueda = document.getElementById('inputBusqueda') as HTMLInputElement;

        busqueda.value = '';

        // Estado
        let productosListados = [] as any[];
        let productosFiltrados = [] as any[];
        let paginaActual = 1;
        const porPagina = 10;

        const tasas = await obtenerTasas();
        const monedaBase = obtenerMonedaBase();

        function htmlPrecio(valor: number) {
            const { principal, secundarias } = desgloseMontos(valor, monedaBase, tasas);
            const referencia = secundarias
                ? `<br /><span style="font-size: .75rem;">${secundarias}</span>`
                : '';
            return `${principal}${referencia}`;
        }

        // Mostrar lote de clientes
        async function mostrarPagina(pagina : number) {

            const inicio = (pagina - 1) * porPagina;
            const fin = inicio + porPagina;
            const lote = productosFiltrados.slice(inicio, fin);

            tbody.innerHTML = '';

            // Si no hay clientes al buscar, mostrar mensaje
            if (lote.length === 0) {
                tbody.innerHTML = "";
                thead.style.display = 'none';
                noRegistros('No se encontraron productos con ese nombre o código');
                btnVerMas.style.display = 'none';
                btnVerAnterior.style.display = pagina > 1 ? 'block' : 'none';
                return;
            } else {
                noRegistros("");
            }

            thead.style.display = 'table-header-group';

            lote.forEach( producto => {
                const tr = document.createElement('tr');
                const costo = Number(producto.costo) || 0;
                const venta = Number(producto.venta) || 0;

                tr.innerHTML = `    
                                    <td data-label="Código y Nombre">
                                        ${producto.codigo}
                                        <br />
                                        ${producto.nombre.toUpperCase()}
                                    </td>
                                    <td data-label="Cantidad">${producto.stock} ${producto.unidad_medida}</td>
                                    <td data-label="Precio de Costo">${htmlPrecio(costo)}</td>
                                    <td data-label="Precio de Venta">${htmlPrecio(venta)}</td>
                                `;

                // Botones de acciones
                const tdAcciones = document.createElement('td');
                tdAcciones.classList.add('acciones');

                const btnAgregar = document.createElement('a');
                btnAgregar.href = `/productos/movimiento?id=${producto.id}&tipo=entrada`;
                btnAgregar.classList.add('btn-stock');
                ponerIcono(btnAgregar, 'agregar');
                tdAcciones.appendChild(btnAgregar);

                const btnSacar = document.createElement('a');
                btnSacar.href = `/productos/movimiento?id=${producto.id}&tipo=salida`;
                btnSacar.classList.add('btn-salida');
                ponerIcono(btnSacar, 'sacar');
                tdAcciones.appendChild(btnSacar);

                const btnHistorial = document.createElement('a');
                btnHistorial.href = `/productos/historial?id=${producto.id}`;
                btnHistorial.classList.add('btn-historial');
                ponerIcono(btnHistorial, 'historial');
                tdAcciones.appendChild(btnHistorial);

                // Boton de eliminar
                const btnEliminar = document.createElement('button');
                btnEliminar.type = 'button';
                btnEliminar.classList.add('btn-eliminar');
                ponerIcono(btnEliminar, 'eliminar');

                btnEliminar.onclick = async () => {
                    // Confirmación antes de eliminar
                    const confirmar = await confirmarAccion(`¿Deseas eliminar el producto ${producto.codigo} - ${producto.nombre}?`, {
                        titulo: 'Eliminar producto',
                        textoAceptar: 'Eliminar',
                    });
                    if (!confirmar) return;

                    // Enviar solicitud de eliminación al servidor
                    try {
                        const res = await fetch('/api/productos/', {
                        method: 'DELETE',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ id: producto.id })
                        });

                        if (!res.ok) {
                            const data = await res.json().catch(() => ({}));
                            mostrarError(data.error || data.message || 'No se pudo inactivar el producto');
                            return;
                        }

                        mostrarMensaje('Producto eliminado correctamente');

                        // Actualiza el array local y repinta
                        productosListados = productosListados.filter(c => c.id !== producto.id);
                        productosFiltrados = aplicarFiltro(busqueda.value);
                        mostrarPagina(1);
                    } catch (error) {
                        mostrarError('Error eliminando producto');
                        console.error("Error eliminando producto:", error);
                    }
                };
                tdAcciones.appendChild(btnEliminar);

                // Boton de editar
                const btnEditar = document.createElement('button');
                btnEditar.type = 'button';
                btnEditar.classList.add('btn-editar');
                ponerIcono(btnEditar, 'editar');
                btnEditar.onclick = () => {
                    window.location.href = `/productos/${producto.id}`;
                };
                tdAcciones.appendChild(btnEditar);

                // Adjuntar acciones al tr
                tr.appendChild(tdAcciones);
                tbody.appendChild(tr);
            });

            btnVerMas.style.display = productosFiltrados.length > fin ? 'block' : 'none';
            btnVerAnterior.style.display = pagina > 1 ? 'block' : 'none';
        }

        // Filtro local por nombre o código
        function aplicarFiltro(texto : string) : any[] {
            if (!texto.trim()) return [...productosListados];

            const filtro = texto.toLowerCase();

            return productosListados.filter(producto =>
                producto.nombre.toLowerCase().includes(filtro) ||
                producto.codigo.toLowerCase().includes(filtro)
            );
        }

        // Cargar desde el backend una sola vez
        async function cargarProductos() {
            try {
                const res = await fetch('/api/productos?limit=500');
                const data = await res.json();

                if (data.message) {
                    tbody.innerHTML = "";
                    thead.style.display = 'none';
                    noRegistros("No hay productos registrados");
                    btnVerMas.style.display = 'none';
                    btnVerAnterior.style.display = 'none';
                    return;
                }

                productosListados = data;
                productosFiltrados = [...productosListados];
                mostrarPagina(paginaActual);
            } catch (err) {
                console.error('Error al cargar productos:', err);
            }
        }

        // Eventos
        busqueda.addEventListener('input', () => {
            paginaActual = 1;
            productosFiltrados = aplicarFiltro(busqueda.value);
            mostrarPagina(paginaActual);
        });

        btnVerMas.addEventListener('click', () => {
            paginaActual++;
            mostrarPagina(paginaActual);
        });

        btnVerAnterior.addEventListener('click', () => {
            if (paginaActual > 1) {
                paginaActual--;
                mostrarPagina(paginaActual);
            }
        });

        cargarProductos();
    });

    const exportarBtn = document.getElementById('exportarBtn' ) as HTMLAnchorElement;
    exportarBtn.addEventListener('click', async () => {
        try {
            const response = await fetch('/api/productos/exportar', {
                method: 'GET',
            });

            if (!response.ok) {
                throw new Error('Error al exportar los productos');
            }

            const blob = await response.blob();
            const url = window.URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = 'productos.xlsx';
            document.body.appendChild(a);
            a.click();
            a.remove();
            window.URL.revokeObjectURL(url);
        } catch (error) {
            console.error('Error al exportar los productos:', error);
        }
    });

</script>