---
import Layout from '../layouts/Layout.astro';
import EmpresaInfo from '../components/EmpresaInfo.astro';
import { verificarToken } from '../utils/auth.js';

const usuario = verificarToken(Astro.request);
if (!usuario) {
    return Astro.redirect('/login');
}

const usuarioNombre = String(usuario.nombre || usuario.usuario || 'Usuario');
const primerNombre = usuarioNombre.split(/\s+/)[0];
const rolEtiqueta = usuario.rol === 'admin' ? 'Administrador' : 'Empleado';
const fechaHoy = new Intl.DateTimeFormat('es-VE', {
    weekday: 'long',
    day: 'numeric',
    month: 'long',
    timeZone: 'America/Caracas',
}).format(new Date());
---

<Layout>
    <main class="dashboard">
        <section class="hero-panel">
            <div class="hero-copy">
                <p class="eyebrow">{fechaHoy}</p>
                <h1>Hola, {primerNombre}</h1>
                <p class="hero-lead">Ventas, inventario y alertas del día en un solo vistazo.</p>
                <p class="hero-meta">{usuarioNombre} · {rolEtiqueta}</p>
                <EmpresaInfo />
            </div>

            <div class="quick-actions">
                <a href="/ventas/agregarVentas" class="quick-link">Registrar venta</a>
                <a href="/clientes/agregarClientes" class="quick-link secondary">Nuevo cliente</a>
            </div>
        </section>

        <div class="kpi-grid">
            <article class="kpi-card" data-kpi="ventas">
                <p class="kpi-label">Ventas de hoy</p>
                <p class="kpi-value" id="kpiVentas">—</p>
                <p class="kpi-hint" id="kpiVentasHint">Cargando…</p>
            </article>
            <article class="kpi-card kpi-card--alert" data-kpi="agotados">
                <p class="kpi-label">Agotados</p>
                <p class="kpi-value" id="kpiAgotados">—</p>
                <p class="kpi-hint">Productos sin stock</p>
            </article>
            <article class="kpi-card kpi-card--warn" data-kpi="stock">
                <p class="kpi-label">Stock bajo</p>
                <p class="kpi-value" id="kpiStock">—</p>
                <p class="kpi-hint">5 unidades o menos</p>
            </article>
        </div>

        <section class="agotados insight-card">
            <div class="section-heading">
                <p class="eyebrow">Alerta</p>
                <h2>Estado del inventario</h2>
            </div>
            <div id="chartAgotados" class="chart-panel"></div>
            {usuario.rol === 'admin' && (
                <a href="/productos" class="section-link">Ver inventario</a>
            )}
        </section>

        <section class="ventas insight-card">
            <div class="section-heading">
                <p class="eyebrow">Actividad</p>
                <h2>Ventas de hoy</h2>
            </div>
            <div id="chartVentas" class="chart-panel"></div>
            <a href="/ventas" class="section-link">Ver ventas</a>
        </section>

        <section class="stock-bajo insight-card">
            <div class="section-heading">
                <p class="eyebrow">Seguimiento</p>
                <h2>Stock más bajo</h2>
            </div>
            <div id="chartStock" class="chart-panel"></div>
            <a href="/reportes" class="section-link">Ver reportes</a>
        </section>
    </main>
</Layout>

<style>
    :global(.content:has(.dashboard)) {
        min-width: 0;
        max-width: 100%;
        overflow-x: clip;
    }

    :global(main.dashboard) {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1fr);
        gap: 1rem;
        width: 100%;
        max-width: 100%;
        min-width: 0;
    }

    :global(main.dashboard) > * {
        min-width: 0;
        max-width: 100%;
    }

    .hero-panel {
        grid-column: 1 / -1;
        position: relative;
        display: grid;
        grid-template-columns: minmax(0, 1.35fr) minmax(0, auto);
        align-items: end;
        gap: 1.25rem;
        padding: 1.35rem 1.4rem 1.3rem;
        background: linear-gradient(135deg, rgba(var(--primary-rgb), 0.96), rgba(var(--secondary-rgb), 0.9) 58%, rgba(var(--accent-rgb), 0.88));
        color: #fff;
        overflow: hidden;
    }

    .hero-panel::after {
        content: '';
        position: absolute;
        width: 280px;
        height: 280px;
        right: -80px;
        top: -110px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.1);
        pointer-events: none;
    }

    .hero-copy,
    .quick-actions,
    .section-heading {
        position: relative;
        z-index: 1;
        min-width: 0;
    }

    .hero-copy {
        display: grid;
        gap: 0.55rem;
        justify-items: start;
    }

    .eyebrow {
        font-size: 0.72rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: rgba(255, 255, 255, 0.68);
    }

    .hero-panel h1 {
        max-width: 100%;
        margin: 0;
        color: #fff;
        font-size: clamp(1.7rem, 3.2vw, 2.55rem);
        line-height: 1.1;
        overflow-wrap: anywhere;
    }

    .hero-lead,
    .hero-meta {
        margin: 0;
        max-width: 46ch;
    }

    .hero-lead {
        color: rgba(255, 255, 255, 0.86);
        font-size: 0.98rem;
        line-height: 1.5;
    }

    .hero-meta {
        color: rgba(255, 255, 255, 0.62);
        font-size: 0.82rem;
        font-weight: 600;
    }

    .quick-actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-end;
        gap: 0.65rem;
    }

    .quick-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 0;
        padding: 0.82rem 1.15rem;
        border-radius: 999px;
        background: #fff;
        color: var(--secondary-color);
        text-decoration: none;
        font-size: 0.84rem;
        font-weight: 800;
        box-shadow: 0 12px 24px rgba(var(--primary-rgb), 0.18);
    }

    .quick-link.secondary {
        background: rgba(255, 255, 255, 0.12);
        border: 1px solid rgba(255, 255, 255, 0.2);
        color: #fff;
        box-shadow: none;
    }

    .kpi-grid {
        grid-column: 1 / -1;
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1rem;
    }

    .kpi-card {
        min-width: 0;
        padding: 1.05rem 1.15rem 1.1rem;
        border-radius: 22px;
        background: rgba(255, 255, 255, 0.9);
        border: 1px solid rgba(var(--secondary-rgb), 0.08);
        box-shadow: 0 14px 28px rgba(var(--primary-rgb), 0.07);
        display: grid;
        gap: 0.28rem;
    }

    .kpi-label {
        margin: 0;
        font-size: 0.7rem;
        font-weight: 800;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--secondary-color);
    }

    .kpi-value {
        margin: 0;
        font-family: 'Archivo Black', sans-serif;
        font-size: clamp(1.35rem, 2.2vw, 1.85rem);
        line-height: 1.15;
        color: var(--primary-strong);
        overflow-wrap: anywhere;
    }

    .kpi-hint {
        margin: 0;
        font-size: 0.8rem;
        color: var(--text-muted);
    }

    .kpi-card--alert .kpi-value {
        color: var(--danger-color);
    }

    .kpi-card--warn .kpi-value {
        color: #b45309;
    }

    .insight-card {
        background: rgba(255, 255, 255, 0.9);
        border: 1px solid rgba(var(--secondary-rgb), 0.08);
        border-radius: 22px;
        padding: 1.1rem 1.15rem 1rem;
        box-shadow: 0 14px 28px rgba(var(--primary-rgb), 0.07);
        display: flex;
        flex-direction: column;
        gap: 0.85rem;
        min-height: 280px;
    }

    .section-heading {
        display: grid;
        gap: 0.15rem;
    }

    .section-heading .eyebrow {
        color: var(--secondary-color);
    }

    .section-heading h2 {
        margin: 0;
        color: var(--primary-strong);
        font-size: 1.05rem;
        font-weight: 800;
    }

    .empty-state {
        margin: 0;
        padding: 0.85rem 0.2rem;
        color: var(--text-muted);
        font-size: 0.9rem;
        line-height: 1.5;
    }

    .chart-panel {
        width: 100%;
        min-width: 0;
        flex: 1;
        overflow: hidden;
    }

    :global(.insight-card .chart-widget) {
        background: transparent;
        border: none;
        box-shadow: none;
        padding: 0;
        max-width: 100%;
    }

    :global(.insight-card .chart-container--compact) {
        min-height: 0;
        max-width: 100%;
    }

    .section-link {
        margin-top: auto;
        align-self: flex-start;
        font-size: 0.78rem;
        font-weight: 800;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: var(--secondary-color);
        text-decoration: none;
    }

    .section-link:hover {
        text-decoration: underline;
    }

    .section-link.hidden {
        display: none;
    }

    @media (max-width: 1024px) {
        :global(main.dashboard),
        .kpi-grid {
            grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        }

        .hero-panel,
        .kpi-grid {
            grid-column: 1 / -1;
        }

        .stock-bajo {
            grid-column: 1 / -1;
        }
    }

    @media (max-width: 768px) {
        :global(main.dashboard),
        .kpi-grid,
        .hero-panel {
            grid-template-columns: minmax(0, 1fr);
        }

        .hero-panel,
        .kpi-grid,
        .agotados,
        .ventas,
        .stock-bajo {
            grid-column: auto;
        }

        .quick-actions {
            justify-content: stretch;
        }

        .quick-link {
            flex: 1 1 140px;
        }

        .insight-card {
            min-height: 0;
        }
    }
</style>

<script>
    import { obtenerTasas } from '@/utils/helpers/cambioMoneda';
    import { obtenerMonedaBase, textoTotal } from '@/utils/helpers/tasas.js';
    import { renderChart } from '@/utils/helpers/chart.js';

    interface Producto {
        nombre: string;
        stock: number;
    }

    interface Venta {
        cliente: string;
        total: number;
    }

    function listaVacia(contenedor: HTMLElement, mensaje: string) {
        contenedor.innerHTML = `<p class="empty-state">${mensaje}</p>`;
    }

    document.addEventListener('DOMContentLoaded', async () => {
        const chartAgotados = document.getElementById('chartAgotados') as HTMLElement;
        const chartVentas = document.getElementById('chartVentas') as HTMLElement;
        const chartStock = document.getElementById('chartStock') as HTMLElement;
        const stockLink = document.querySelector('.stock-bajo .section-link') as HTMLAnchorElement | null;
        const kpiVentas = document.getElementById('kpiVentas');
        const kpiVentasHint = document.getElementById('kpiVentasHint');
        const kpiAgotados = document.getElementById('kpiAgotados');
        const kpiStock = document.getElementById('kpiStock');

        const [tasas, resumenRes, ventasRes, stockRes] = await Promise.all([
            obtenerTasas(),
            fetch('/api/index/resumen'),
            fetch('/api/index/ventas'),
            fetch('/api/index/stockBajo'),
        ]);

        const monedaBase = obtenerMonedaBase();
        let resumen = {
            productosActivos: 0,
            agotados: 0,
            stockBajo: 0,
            ventasHoy: 0,
            totalHoy: 0,
        };

        if (resumenRes.ok) {
            resumen = await resumenRes.json();
            if (kpiAgotados) kpiAgotados.textContent = String(resumen.agotados ?? 0);
            if (kpiStock) kpiStock.textContent = String(resumen.stockBajo ?? 0);
            if (kpiVentas) kpiVentas.textContent = String(resumen.ventasHoy ?? 0);
            if (kpiVentasHint) {
                kpiVentasHint.textContent = resumen.ventasHoy
                    ? textoTotal(resumen.totalHoy, monedaBase, tasas)
                    : 'Sin movimientos registrados';
            }
        } else if (kpiVentasHint) {
            kpiVentasHint.textContent = 'No se pudo cargar el resumen';
        }

        const enRango = Math.max(0, Number(resumen.productosActivos) - Number(resumen.agotados) - Number(resumen.stockBajo));
        const inventario = [
            { label: 'Agotados', value: Number(resumen.agotados) || 0 },
            { label: 'Stock bajo', value: Number(resumen.stockBajo) || 0 },
            { label: 'En rango', value: enRango },
        ].filter((item) => item.value > 0);

        if (inventario.length > 0) {
            renderChart(
                'Estado del inventario',
                inventario.map((item) => item.label),
                inventario.map((item) => item.value),
                { containerId: 'chartAgotados', type: 'doughnut', compact: true, hideTitle: true, valueLabel: 'Productos' }
            );
        } else {
            listaVacia(chartAgotados, 'Todavía no hay productos en el inventario.');
        }

        const ventasData = await ventasRes.json();
        if (ventasRes.status === 200 && Array.isArray(ventasData) && ventasData.length > 0) {
            renderChart(
                'Ventas de hoy',
                ventasData.map((venta: Venta) => venta.cliente),
                ventasData.map((venta: Venta) => Number(venta.total) || 0),
                { containerId: 'chartVentas', compact: true, hideTitle: true, valueLabel: monedaBase }
            );
        } else {
            listaVacia(chartVentas, 'Aún no hay ventas hoy.');
        }

        const stockData = await stockRes.json();
        if (stockRes.status === 200 && Array.isArray(stockData) && stockData.length > 0) {
            renderChart(
                'Stock más bajo',
                stockData.map((producto: Producto) => producto.nombre),
                stockData.map((producto: Producto) => Number(producto.stock) || 0),
                { containerId: 'chartStock', compact: true, hideTitle: true, valueLabel: 'Stock' }
            );
        } else {
            listaVacia(chartStock, 'No hay productos con stock bajo.');
            stockLink?.classList.add('hidden');
        }
    });
</script>
